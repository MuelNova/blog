---
import Layout from '../layouts/BlogPost.astro';
import { defaultLang, resolveLang, type Lang, useTranslations } from '../i18n/config';

const { lang: langProp } = Astro.props as { lang?: Lang };
const lang = langProp ?? resolveLang(Astro.url.pathname) ?? defaultLang;
const t = useTranslations(lang);

const content = {
	en: {
		description: 'About me - security research, tools, and writing',
		terminalTitle: 'who am i',
		terminalLines: [
			{ prompt: 'whoami', output: 'MuelNova (muir / Miao Zhao)' },
			{ prompt: 'cat ~/fingerprint.txt', output: '6C4F 47DB A3A8 EB3B 5670 172A 6AC1 E2FC FE4A A441' },
			{ prompt: 'check -d 2025 --short', output: 'PKU School of CS · Master 2025 · Security Research' },
			{ prompt: 'open github', output: 'github.com/MuelNova' },
			{ prompt: 'mail muel@nova.gal', output: '' },
		],
		timelineTitle: 'Milestones',
		timeline: [
			{ time: '2025 · Now', desc: 'PKU CS Master – Security Research' },
			{ time: '2021 - 2025', desc: 'BUPT Cybersecurity B.S. – CTF / PWN' },
			{ time: 'Earlier', desc: 'Building and breaking things' },
		],
		doingTitle: 'What I do',
		doing: [
			'Vul337 / PKU CCLab security research',
			'Exploring memory-safety mitigations and offensive chains',
			'Writing on systems security, toolchains, and workflows',
		],
		skillsTitle: 'Skills',
		skills: ['Python / Go / TypeScript / C++', 'Linux / Arch', 'GDB / pwntools / angr', 'Rust (learning)', 'Astro / Tailwind / React'],
		contactTitle: 'Contact',
		contact: [
			{ label: 'Email', value: 'muel@nova.gal', href: 'mailto:muel@nova.gal' },
			{ label: 'GitHub', value: '@MuelNova', href: 'https://github.com/MuelNova' },
		],
	},
	zh: {
		description: '关于我 - 安全研究、工具与写作',
		terminalTitle: 'who am i',
		terminalLines: [
			{ prompt: 'whoami', output: 'Muelnova (muir / Miao Zhao)' },
			{ prompt: 'cat ~/fingerprint.txt', output: '6C4F 47DB A3A8 EB3B 5670 172A 6AC1 E2FC FE4A A441' },
			{ prompt: 'check -d 2025 --short', output: '北京大学计算机学院 · 25 级硕士 · 安全研究' },
			{ prompt: 'open github', output: 'github.com/MuelNova' },
			{ prompt: 'mail muel@nova.gal', output: '' },
		],
		timelineTitle: '一些节点',
		timeline: [
			{ time: '2025 · 现在', desc: 'PKU CS 硕士 - 安全研究' },
			{ time: '2021 - 2025', desc: 'BUPT 网络安全 本科 - CTF / PWN' },
			{ time: '更早', desc: '玩泥巴' },
		],
		doingTitle: '正在做的事',
		doing: [
			'在 vul337 / pkucclab 做安全研究',
			'探索内存安全缓解与渗透链路',
			'写一些关于系统安全、工具链和工作流的文章',
		],
		skillsTitle: '技能',
		skills: ['Python / Go / TypeScript / C++', 'Linux / Arch', 'GDB / pwntools / angr', 'Rust（路上）', 'Astro / Tailwind / React'],
		contactTitle: '联系',
		contact: [
			{ label: 'Email', value: 'muel@nova.gal', href: 'mailto:muel@nova.gal' },
			{ label: 'GitHub', value: '@MuelNova', href: 'https://github.com/MuelNova' },
		],
	},
} as const;

const copy = content[lang] ?? content[defaultLang];
---

<Layout title={t('about.title')} description={copy.description} showTitle={false} lang={lang}>
	<div class="about-shell prose prose-invert max-w-none py-6">
	<section class="about-hero">
		<img
			src="https://github.com/MuelNova.png"
			alt="MuelNova avatar"
			class="avatar"
			width="128"
			height="128"
			loading="lazy"
		/>
		<div class="terminal">
			<div class="terminal-header">
				<span class="dot red"></span>
				<span class="dot yellow"></span>
				<span class="dot green"></span>
				<span class="terminal-title">{copy.terminalTitle}</span>
			</div>
			<div class="terminal-body">
				{copy.terminalLines.map(({ prompt, output }) => (
					<div>
						<div class="line">
							<span class="prompt">root@nova.gal</span>:<span class="path">~</span>$ {prompt}
						</div>
						{output && <div class="output">{prompt.includes('github') ? <a href="https://github.com/MuelNova" target="_blank" rel="noopener noreferrer">{output}</a> : output}</div>}
					</div>
				))}
				<div class="line">
					<span class="prompt">root@nova.gal</span>:<span class="path">~/contact</span>$ mail muel@nova.gal
					<span class="cursor" aria-hidden="true"></span>
				</div>
			</div>
		</div>
	</section>

	<!-- <section class="about-grid">
		<div class="card">
			<h2>现在</h2>
			<ul class="pill-list">
				<li>北京大学 · 计算机科学 · 25 级硕士</li>
				<li>NetSec / Binary / PWN</li>
				<li>写代码、写论文、写博客</li>
			</ul>
		</div>
		<div class="card">
			<h2>之前</h2>
			<ul class="pill-list">
				<li>北京邮电大学 · 网络安全 · 21 级本科</li>
				<li><a href="https://www.buptmerak.cn" target="_blank" rel="noopener noreferrer">天璇 Merak</a> / 天枢 Dubhe 二进制方向</li>
				<li>多项 CTF / 网络安全竞赛获奖</li>
			</ul>
		</div>
	</section> -->

	<section class="timeline card">
		<h3>{copy.timelineTitle}</h3>
		<ul>
			{copy.timeline.map((item) => (
				<li>
					<span class="time">{item.time}</span>
					<span class="desc">{item.desc}</span>
				</li>
			))}
		</ul>
	</section>

	<section class="about-cards">
		<div class="card">
			<h3>{copy.doingTitle}</h3>
			<ul class="bullet-list">
				{copy.doing.map((item) => (
					<li>{item}</li>
				))}
			</ul>
		</div>
		<div class="card">
			<h3>{copy.skillsTitle}</h3>
			<ul class="pill-list compact">
				{copy.skills.map((item) => (
					<li>{item}</li>
				))}
			</ul>
		</div>
	</section>

	<section class="contact card">
		<h3>{copy.contactTitle}</h3>
		<ul class="bullet-list">
			{copy.contact.map((item) => (
				<li>
					{item.label}: <a href={item.href} target="_blank" rel="noopener noreferrer">{item.value}</a>
				</li>
			))}
		</ul>
	</section>
	</div>
</Layout>

<style>
	.about-hero {
		display: grid;
		gap: 1.25rem;
		justify-items: center;
		margin-bottom: 2rem;
	}

	.avatar {
		width: 128px;
		height: 128px;
		border-radius: 999px;
		border: 2px solid color-mix(in srgb, var(--color-primary) 30%, transparent);
		box-shadow: 0 0 22px color-mix(in srgb, var(--color-primary) 28%, transparent);
	}

	.about-shell {
		max-width: 960px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	.terminal {
		border: 1px solid color-mix(in srgb, var(--color-primary) 35%, transparent);
		border-radius: 12px;
		background: color-mix(in srgb, var(--color-background) 90%, transparent);
		overflow: hidden;
		font-family: var(--font-mono, monospace);
	}

	.terminal-header {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.6rem 0.9rem;
		background: color-mix(in srgb, var(--color-foreground) 6%, transparent);
		border-bottom: 1px solid color-mix(in srgb, var(--color-primary) 25%, transparent);
	}

	.terminal-title {
		margin-left: auto;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
	}

	.dot {
		display: inline-flex;
		width: 10px;
		height: 10px;
		border-radius: 999px;
		box-shadow: 0 0 4px currentColor;
	}

	.dot.red { color: #ff5f56; }
	.dot.yellow { color: #ffbd2e; }
	.dot.green { color: #27c93f; }

	.terminal-body {
		padding: 1rem 1.25rem 1.15rem;
		display: grid;
		gap: 0.45rem;
		background: radial-gradient(circle at 20% 20%, color-mix(in srgb, var(--color-primary) 12%, transparent), transparent 45%),
			radial-gradient(circle at 80% 10%, color-mix(in srgb, var(--color-primary-light) 10%, transparent), transparent 40%),
			color-mix(in srgb, var(--color-background) 94%, transparent);
	}

	.line,
	.output {
		font-size: 0.95rem;
		color: color-mix(in srgb, var(--color-foreground) 88%, transparent);
		word-break: break-word;
	}

	.prompt {
		color: var(--color-primary);
		font-weight: 600;
	}

	.path {
		color: color-mix(in srgb, var(--color-primary-light) 90%, var(--color-foreground) 10%);
	}

	.output a {
		color: var(--color-link);
		text-decoration: none;
	}

	.output a:hover {
		text-decoration: underline;
	}

	.cursor {
		display: inline-block;
		width: 0.7em;
		height: 1.1em;
		background: var(--color-primary);
		margin-left: 0.15em;
		animation: blink 1.1s step-end infinite;
		vertical-align: -0.1em;
	}

	@keyframes blink {
		50% { opacity: 0; }
	}

	.about-grid {
		display: grid;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.about-cards {
		display: grid;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.card {
		border: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
		border-radius: 12px;
		padding: 1rem;
		background: color-mix(in srgb, var(--color-foreground) 3%, transparent);
	}

	.card h2,
	.card h3 {
		margin: 0 0 0.75rem 0;
	}

	.pill-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.pill-list li {
		padding: 0.35rem 0.75rem;
		border: 1px solid color-mix(in srgb, var(--color-foreground) 15%, transparent);
		border-radius: 999px;
		font-size: 0.95rem;
		background: color-mix(in srgb, var(--color-foreground) 5%, transparent);
	}

	.pill-list.compact li {
		font-size: 0.9rem;
		padding: 0.3rem 0.65rem;
	}

	.bullet-list {
		padding-left: 1.25rem;
		margin: 0;
		display: grid;
		gap: 0.65rem;
	}

	.bullet-list li {
		color: color-mix(in srgb, var(--color-foreground) 90%, transparent);
	}

	.timeline {
		margin-bottom: 1.5rem;
	}

	.timeline ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.75rem;
	}

	.timeline li {
		display: grid;
		gap: 0.15rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px dashed color-mix(in srgb, var(--color-foreground) 15%, transparent);
	}

	.timeline li:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.time {
		font-weight: 600;
		color: var(--color-primary-light);
	}

	.desc {
		color: color-mix(in srgb, var(--color-foreground) 80%, transparent);
	}

	.contact {
		margin-bottom: 0.5rem;
	}

	.contact a {
		color: var(--color-link);
		text-decoration: none;
	}

	.contact a:hover {
		text-decoration: underline;
	}

	@media (min-width: 768px) {
		.about-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.about-cards {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
