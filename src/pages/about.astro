---
import Layout from '../layouts/BlogPost.astro';
import { defaultLang, resolveLang, type Lang, useTranslations } from '../i18n/config';

const { lang: langProp } = Astro.props as { lang?: Lang };
const lang = langProp ?? resolveLang(Astro.url.pathname) ?? defaultLang;
const t = useTranslations(lang);

interface Fact {
	label: string;
	value: string;
	href?: string;
	mono?: boolean;
}

const content = {
	en: {
		description: 'About me - security research, tools, and writing',
		name: 'MuelNova (muir / Miao Zhao)',
		tagline: 'sweet dreams are made of this',
		facts: [
			{ label: 'fingerprint', value: '6C4F 47DB A3A8 EB3B 5670 172A 6AC1 E2FC FE4A A441', mono: true },
			{ label: 'now', value: 'PKU School of CS · Master 2025 · Security Research' },
			{ label: 'github', value: 'github.com/MuelNova', href: 'https://github.com/MuelNova', mono: true },
			{ label: 'mail', value: 'muel@nova.gal', href: 'mailto:muel@nova.gal', mono: true },
		] as Fact[],
		sections: {
			timeline: { en: 'TIMELINE', zh: '时间线' },
			doing: { en: 'NOW', zh: '正在做的事' },
			skills: { en: 'SKILLS', zh: '技能' },
			contact: { en: 'CONTACT', zh: '联系方式' },
		},
		timeline: [
			{ time: '2025 · Now', desc: 'PKU CS Master – Security Research' },
			{ time: '2021 - 2025', desc: 'BUPT Cybersecurity B.S. – CTF / PWN' },
			{ time: 'Earlier', desc: 'Building and breaking things' },
		],
		doing: [
			'Vul337 / PKU CCLab security research',
			'Exploring memory-safety mitigations and offensive chains',
			'Writing on systems security, toolchains, and workflows',
		],
		skills: [
			{ name: 'Python / Go / TypeScript / C++', level: 85 },
			{ name: 'Linux / Arch', level: 80 },
			{ name: 'GDB / pwntools / angr', level: 75 },
			{ name: 'Rust (learning)', level: 40 },
			{ name: 'Astro / Tailwind / React', level: 65 },
		],
		contact: [
			{ label: 'Email', value: 'muel@nova.gal', href: 'mailto:muel@nova.gal' },
			{ label: 'GitHub', value: '@MuelNova', href: 'https://github.com/MuelNova' },
		],
	},
	zh: {
		description: '关于我 - 安全研究、工具与写作',
		name: 'Muelnova (muir / Miao Zhao)',
		tagline: 'sweet dreams are made of this',
		facts: [
			{ label: 'fingerprint', value: '6C4F 47DB A3A8 EB3B 5670 172A 6AC1 E2FC FE4A A441', mono: true },
			{ label: 'now', value: '北京大学计算机学院 · 25 级硕士 · 安全研究' },
			{ label: 'github', value: 'github.com/MuelNova', href: 'https://github.com/MuelNova', mono: true },
			{ label: 'mail', value: 'muel@nova.gal', href: 'mailto:muel@nova.gal', mono: true },
		] as Fact[],
		sections: {
			timeline: { en: 'TIMELINE', zh: '时间线' },
			doing: { en: 'NOW', zh: '正在做的事' },
			skills: { en: 'SKILLS', zh: '技能' },
			contact: { en: 'CONTACT', zh: '联系方式' },
		},
		timeline: [
			{ time: '2025 · 现在', desc: 'PKU CS 硕士 - 安全研究' },
			{ time: '2021 - 2025', desc: 'BUPT 网络安全 本科 - CTF / PWN' },
			{ time: '更早', desc: '玩泥巴' },
		],
		doing: [
			'在 vul337 / pkucclab 做安全研究',
			'探索内存安全缓解与渗透链路',
			'写一些关于系统安全、工具链和工作流的文章',
		],
		skills: [
			{ name: 'Python / Go / TypeScript / C++', level: 85 },
			{ name: 'Linux / Arch', level: 80 },
			{ name: 'GDB / pwntools / angr', level: 75 },
			{ name: 'Rust（路上）', level: 40 },
			{ name: 'Astro / Tailwind / React', level: 65 },
		],
		contact: [
			{ label: 'Email', value: 'muel@nova.gal', href: 'mailto:muel@nova.gal' },
			{ label: 'GitHub', value: '@MuelNova', href: 'https://github.com/MuelNova' },
		],
	},
};

const copy = content[lang] ?? content[defaultLang];
---

<Layout title={t('about.title')} description={copy.description} showTitle={false} lang={lang}>
	<div class="about-shell py-6">
		<!-- Hero: avatar + name + identity facts (terminal removed) -->
		<header class="about-hero">
			<img
				src="https://github.com/MuelNova.png"
				alt="MuelNova avatar"
				class="avatar"
				width="128"
				height="128"
				loading="lazy"
			/>
			<h1 class="about-name font-display">{copy.name}</h1>
			<p class="about-tagline font-hand" aria-hidden="true">{copy.tagline}</p>
			<ul class="fact-list">
				{copy.facts.map((fact) => (
					<li class="fact-row">
						<span class="fact-label font-mono">{fact.label}</span>
						{fact.href ? (
							<a class:list={["fact-value", { "font-mono": fact.mono }]} href={fact.href} target="_blank" rel="noopener noreferrer">{fact.value}</a>
						) : (
							<span class:list={["fact-value", { "font-mono": fact.mono }]}>{fact.value}</span>
						)}
					</li>
				))}
			</ul>
		</header>

		<!-- Timeline -->
		<section class="about-section">
			<div class="section-heading">
				<h2 class="section-title-en font-display">{copy.sections.timeline.en}</h2>
				<span class="section-title-zh font-display">{copy.sections.timeline.zh}</span>
			</div>
			<div class="section-body">
				<ul class="timeline-list">
					{copy.timeline.map((item) => (
						<li class="timeline-item">
							<span class="timeline-dot" aria-hidden="true"></span>
							<span class="timeline-time font-mono">{item.time}</span>
							<span class="timeline-desc">{item.desc}</span>
						</li>
					))}
				</ul>
			</div>
		</section>

		<!-- What I do -->
		<section class="about-section">
			<div class="section-heading">
				<h2 class="section-title-en font-display">{copy.sections.doing.en}</h2>
				<span class="section-title-zh font-display">{copy.sections.doing.zh}</span>
			</div>
			<div class="section-body">
				<ul class="bullet-list">
					{copy.doing.map((item) => (
						<li>{item}</li>
					))}
				</ul>
			</div>
		</section>

		<!-- Skills: single-color progress bars -->
		<section class="about-section">
			<div class="section-heading">
				<h2 class="section-title-en font-display">{copy.sections.skills.en}</h2>
				<span class="section-title-zh font-display">{copy.sections.skills.zh}</span>
			</div>
			<div class="section-body">
				<ul class="skill-list">
					{copy.skills.map((skill) => (
						<li class="skill-row">
							<div class="skill-meta">
								<span class="skill-name">{skill.name}</span>
								<span class="skill-pct font-mono" data-level={skill.level}>0%</span>
							</div>
							<div class="skill-track" role="img" aria-label={`${skill.name}: ${skill.level}%`}>
								<span class="skill-fill" data-level={skill.level} style="width: 0%;"></span>
							</div>
						</li>
					))}
				</ul>
			</div>
		</section>

		<!-- Contact -->
		<section class="about-section">
			<div class="section-heading">
				<h2 class="section-title-en font-display">{copy.sections.contact.en}</h2>
				<span class="section-title-zh font-display">{copy.sections.contact.zh}</span>
			</div>
			<div class="section-body">
				<ul class="bullet-list contact-list">
					{copy.contact.map((item) => (
						<li>
							{item.label}: <a href={item.href} target="_blank" rel="noopener noreferrer">{item.value}</a>
						</li>
					))}
				</ul>
			</div>
		</section>
	</div>
</Layout>

<style>
	.about-shell {
		max-width: 960px;
		margin: 0 auto;
		padding: 0 1rem;
		color: var(--color-foreground);
	}

	/* ===== Hero ===== */
	.about-hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.5rem;
		margin-bottom: 3rem;
	}

	.avatar {
		width: 128px;
		height: 128px;
		border-radius: 32px;
		border: 2px solid var(--color-border);
		margin-bottom: 0.5rem;
	}

	.about-name {
		margin: 0;
		font-size: 1.75rem;
		line-height: 1.2;
		color: var(--color-foreground);
	}

	.about-tagline {
		margin: 0;
		font-size: 1.25rem;
		color: var(--color-accent);
		transform: rotate(-2deg);
	}

	.fact-list {
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		width: 100%;
		max-width: 30rem;
		text-align: left;
	}

	.fact-row {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		padding: 0.375rem 0;
		border-bottom: 1px dashed var(--color-border);
		font-size: 0.8125rem;
	}

	.fact-row:last-child {
		border-bottom: none;
	}

	.fact-label {
		flex-shrink: 0;
		min-width: 5.5rem;
		font-size: 0.6875rem;
		color: var(--color-accent);
		letter-spacing: 0.04em;
	}

	.fact-value {
		color: var(--color-foreground);
		word-break: break-word;
	}

	a.fact-value {
		color: var(--color-link);
		text-decoration: none;
	}

	a.fact-value:hover {
		text-decoration: underline;
	}

	/* ===== Magazine sections: sticky heading + content flow ===== */
	.about-section {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;
		padding: 1.75rem 0;
		border-top: 1px solid var(--color-border);
	}

	@media (min-width: 768px) {
		.about-section {
			grid-template-columns: 11rem 1fr;
			gap: 2rem;
		}
	}

	.section-heading {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
	}

	@media (min-width: 768px) {
		.section-heading {
			position: sticky;
			top: 4.5rem;
			align-self: start;
		}
	}

	.section-title-en {
		margin: 0;
		font-size: 1.375rem;
		line-height: 1.1;
		letter-spacing: 0.06em;
		color: var(--color-foreground);
		text-transform: uppercase;
	}

	.section-title-zh {
		font-size: 0.8125rem;
		color: var(--color-foreground-secondary);
	}

	.section-body {
		min-width: 0;
	}

	/* ===== Timeline: dots + outlines ===== */
	.timeline-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}

	.timeline-item {
		position: relative;
		display: grid;
		gap: 0.125rem;
		padding: 0 0 1.25rem 1.75rem;
		border-left: 2px solid var(--color-border);
	}

	.timeline-item:last-child {
		padding-bottom: 0;
		border-left-color: transparent;
	}

	.timeline-dot {
		position: absolute;
		left: -0.4375rem;
		top: 0.25rem;
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 9999px;
		background: var(--color-surface);
		border: 2px solid var(--color-accent);
	}

	.timeline-time {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--color-accent);
		letter-spacing: 0.02em;
	}

	.timeline-desc {
		font-size: 0.9375rem;
		color: var(--color-foreground);
	}

	/* ===== Bullet lists ===== */
	.bullet-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.625rem;
	}

	.bullet-list li {
		position: relative;
		padding-left: 1.25rem;
		font-size: 0.9375rem;
		color: var(--color-foreground);
	}

	.bullet-list li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 9999px;
		background: var(--color-accent);
	}

	.contact-list a {
		color: var(--color-link);
		text-decoration: none;
	}

	.contact-list a:hover {
		text-decoration: underline;
	}

	/* ===== Skills: single-color pill progress bars ===== */
	.skill-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
	}

	.skill-meta {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 0.375rem;
	}

	.skill-name {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--color-foreground);
	}

	.skill-pct {
		font-size: 0.75rem;
		color: var(--color-foreground-secondary);
	}

	.skill-track {
		height: 0.625rem;
		border-radius: 100px;
		background: var(--color-surface-deep);
		overflow: hidden;
	}

	.skill-fill {
		display: block;
		height: 100%;
		border-radius: 100px;
		background: var(--color-accent);
		transition: width 1s var(--ease-out);
	}

	@media (prefers-reduced-motion: reduce) {
		.skill-fill {
			transition: none;
		}
	}
</style>

<script>
	// Skill bars: animate width + count up when scrolled into view
	const skillFills = document.querySelectorAll<HTMLElement>('.skill-fill');
	const skillPcts = document.querySelectorAll<HTMLElement>('.skill-pct');

	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	function animateSkill(fill: HTMLElement, pct: HTMLElement | null, level: number) {
		fill.style.width = `${level}%`;
		if (!pct) return;
		if (reducedMotion) {
			pct.textContent = `${level}%`;
			return;
		}
		const duration = 1000;
		const start = performance.now();
		const tick = (now: number) => {
			const progress = Math.min((now - start) / duration, 1);
			// ease-out cubic to roughly match the width transition
			const eased = 1 - Math.pow(1 - progress, 3);
			pct.textContent = `${Math.round(eased * level)}%`;
			if (progress < 1) requestAnimationFrame(tick);
		};
		requestAnimationFrame(tick);
	}

	if ('IntersectionObserver' in window && !reducedMotion) {
		const pctByLevel = new Map<Element, HTMLElement>();
		skillPcts.forEach((pct) => pctByLevel.set(pct.closest('.skill-row')!, pct));

		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				const fill = entry.target as HTMLElement;
				const level = parseInt(fill.dataset.level || '0');
				const row = fill.closest('.skill-row');
				animateSkill(fill, row ? pctByLevel.get(row) ?? null : null, level);
				observer.unobserve(fill);
			});
		}, { threshold: 0.4 });

		skillFills.forEach((fill) => observer.observe(fill));
	} else {
		// No IO support or reduced motion: set final state immediately
		skillFills.forEach((fill) => fill.style.width = `${fill.dataset.level || '0'}%`);
		skillPcts.forEach((pct) => pct.textContent = `${pct.dataset.level || '0'}%`);
	}
</script>
