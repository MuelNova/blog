---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import ProfileCard from '../components/ProfileCard.astro';
import SocialsCard from '../components/SocialsCard.astro';
import AboutCard from '../components/AboutCard.astro';
import LatestPosts from '../components/LatestPosts.astro';
import { SITE_DESCRIPTION, SITE_TITLE, USER_NAME } from '../consts';
import { QUICK_INFO, SOCIAL_LINKS } from '../config/profile';

// Get latest 2 blog posts
const posts = (await getCollection('blog'))
	.filter(post => !post.data.unlisted)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 2);
---

<PageLayout 
	title={SITE_TITLE} 
	description={SITE_DESCRIPTION}
	class="w-full max-w-[1280px] mx-auto flex flex-col gap-8 py-8"
>
	<!-- Two Column Grid Layout -->
	<div class="grid grid-cols-1 lg:grid-cols-[2fr_5fr] gap-8">
		<!-- Left Column -->
		<div class="flex flex-col gap-8">
			<ProfileCard name={USER_NAME} info={QUICK_INFO} />
			<SocialsCard socials={SOCIAL_LINKS} />
		</div>

		<!-- Right Column -->
		<div class="flex flex-col gap-8">
			<!-- About Section with accent header -->
			
				<AboutCard>
					<p>If you see this, you know I'm still developing this site.</p>
				</AboutCard>
			
			<!-- Divider -->
			<div class="flex items-center gap-4 my-2">
				<hr class="flex-1 bg-accent h-0.5 border-none" />
				<span class="text-accent/70 text-sm font-semibold">Latest Posts</span>
				<hr class="flex-1 bg-accent h-0.5 border-none" />
			</div>
			
			<LatestPosts posts={posts} />
		</div>
	</div>
</PageLayout>
