---
import { Icon } from 'astro-icon/components';
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { defaultLang, getRelativeLocaleUrl, monthNames as monthNamesByLang, resolveLang, useTranslations } from '../../i18n/config';
import type { Lang } from '../../i18n/config';
import { getAllPostsWithPreferredLang, getPostBaseId } from '../../i18n/i18n';

const { lang: langProp } = Astro.props as { lang?: Lang };
const lang = langProp ?? resolveLang(Astro.url.pathname) ?? defaultLang;

const posts = await getAllPostsWithPreferredLang(lang);

const t = useTranslations(lang);
const monthNames = monthNamesByLang[lang];

// Index-style date: 2025.01.15 (mono, locale-independent)
const pad = (n: number) => String(n).padStart(2, '0');
const indexDate = (d: Date) => `${d.getFullYear()}.${pad(d.getMonth() + 1)}.${pad(d.getDate())}`;

// Page header copy — Chinese words stay inside the ZCOOL KuaiLe subset
const pageTitle = lang === 'zh' ? '博客' : 'Blog';
const archiveLabel = lang === 'zh' ? '归档' : 'Archive';

// Collect all tags with their counts and sort by count (descending)
const tagCounts = new Map<string, number>();
posts.forEach((post) => {
	(post.data.tags || []).forEach((tag) => {
		tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
	});
});

const sortedTags = Array.from(tagCounts.entries())
	.sort((a, b) => b[1] - a[1]) // Sort by count descending
	.map(([tag, count]) => ({ tag, count }));

// Collect all dates with their counts - group by year and month
interface MonthData {
	month: number;
	count: number;
}

interface YearData {
	year: number;
	count: number;
	months: MonthData[];
}

const dateGroups = new Map<number, Map<number, number>>();
posts.forEach((post) => {
	const date = post.data.pubDate;
	const year = date.getFullYear();
	const month = date.getMonth() + 1; // 1-12

	if (!dateGroups.has(year)) {
		dateGroups.set(year, new Map());
	}
	const yearMap = dateGroups.get(year)!;
	yearMap.set(month, (yearMap.get(month) || 0) + 1);
});

// Convert to sorted array (years descending, months descending)
const sortedDateGroups: YearData[] = Array.from(dateGroups.entries())
	.sort((a, b) => b[0] - a[0]) // Sort years descending
	.map(([year, monthsMap]) => ({
		year,
		count: Array.from(monthsMap.values()).reduce((sum, count) => sum + count, 0),
		months: Array.from(monthsMap.entries())
			.sort((a, b) => b[0] - a[0]) // Sort months descending
			.map(([month, count]) => ({ month, count })),
	}));

---

<PageLayout
	title={SITE_TITLE}
	description={SITE_DESCRIPTION}
	lang={lang}
	class="w-full max-w-[1400px] xl:max-w-[1600px] mx-auto py-3 md:py-8 px-0 md:px-4"
>
	<!-- Page header — display font + handwritten accent -->
	<header class="blog-hero">
		<h1 class="blog-hero-title font-display">{pageTitle}</h1>
		<p class="blog-hero-hand font-hand" aria-hidden="true">sweet notes &amp; tech dreams</p>
	</header>

	<!-- Mobile Filter Button - Sticker Pill -->
	{sortedTags.length > 0 && (
		<button
			id="mobile-filter-btn"
			class="lg:hidden fixed bottom-4 left-2 z-50 flex items-center gap-1.5 px-3.5 py-2 rounded-pill border-2 border-border bg-surface text-foreground transition-transform duration-200"
			aria-label={t('blog.filters')}
			style="transform: translateX(0);"
		>
			<Icon name="ph:funnel" class="w-5 h-5 text-accent-2" />
			<span class="text-xs font-semibold">{t('blog.filters')}</span>
		</button>
	)}

	<!-- Mobile Filter Overlay -->
	{sortedTags.length > 0 && (
		<div
			id="mobile-filter-overlay"
			class="lg:hidden fixed inset-0 bg-background/95 backdrop-blur-sm z-[60] opacity-0 pointer-events-none transition-opacity duration-300"
		>
			<div class="h-full overflow-y-auto p-4 pb-20 relative">
				<div class="flex justify-between items-center mb-4 relative z-[61]">
					<h2 class="text-xl font-semibold text-foreground font-display flex items-center gap-2 m-0">
						<Icon name="ph:funnel" class="w-5 h-5 text-accent-2" />
						{t('blog.filters')}
					</h2>
					<button
						id="mobile-filter-close"
						class="p-2 rounded-pill border-2 border-border hover:border-primary transition-colors relative z-[61]"
						aria-label="Close filters"
					>
						<Icon name="ph:x" class="w-6 h-6 text-foreground" />
					</button>
				</div>

				<!-- Tags Section -->
				<div class="mb-6">
					<div class="flex items-center justify-between mb-3">
						<h3 class="panel-title m-0">
							<Icon name="ph:folder" class="w-4 h-4 text-accent-2" />
							{t('blog.tags')}
						</h3>
						<button
							id="clear-tags-filter-mobile"
							class="clear-filter-btn"
							title={t('blog.clearTags')}
							style="visibility: hidden; opacity: 0; pointer-events: none;"
						>
							<Icon name="ph:x" class="w-3.5 h-3.5" />
						</button>
					</div>
					<ul class="tags-list">
						{sortedTags.map(({ tag, count }) => (
							<li>
								<button
									class="blog-tag"
									data-tag={tag}
								>
									<span class="tag-name">{tag}</span>
									<span class="tag-count">{count}</span>
								</button>
							</li>
						))}
					</ul>
				</div>

				<!-- Date Section -->
				{sortedDateGroups.length > 0 && (
					<div>
						<div class="flex items-center justify-between mb-3">
							<h3 class="panel-title m-0">
								<Icon name="ph:calendar-blank" class="w-4 h-4 text-accent-2" />
								{archiveLabel}
							</h3>
							<button
								id="clear-date-filter-mobile"
								class="clear-filter-btn"
								title={t('blog.clearDate')}
								style="visibility: hidden; opacity: 0; pointer-events: none;"
							>
								<Icon name="ph:x" class="w-3.5 h-3.5" />
							</button>
						</div>
						<nav class="date-filter-nav">
							<ul class="date-list">
								{sortedDateGroups.map(({ year, count, months }, index) => (
									<li class="year-group">
										<button
											class="year-button mobile"
											data-year={year}
											data-expanded={index === 0 ? 'true' : 'false'}
										>
											<span class="year-indicator">›</span>
											<span class="year-label font-mono">{year}</span>
											<span class="year-count">{count}</span>
										</button>
										<ul class="month-list" style={index === 0 ? '' : 'display: none;'}>
											{months.map(({ month, count }) => (
												<li>
													<button
														class="month-button mobile"
														data-year={year}
														data-month={month}
													>
														<span class="month-name">{monthNames[month - 1]}</span>
														<span class="month-count">{count}</span>
													</button>
												</li>
											))}
										</ul>
									</li>
								))}
							</ul>
						</nav>
					</div>
				)}
			</div>
		</div>
	)}

	<div class="blog-layout">
		<!-- Desktop Tag Filter (bare pill cloud, sticky) -->
		{sortedTags.length > 0 && (
			<section class="filter-panel hidden lg:block lg:sticky lg:top-4 lg:self-start" aria-label={t('blog.filterLabel')}>
				<div class="flex items-center gap-2 mb-3">
					<h2 class="panel-title m-0">
						<Icon name="ph:folder" class="w-4 h-4 text-accent-2" />
						{t('blog.tags')}
					</h2>
					<button
						id="clear-tags-filter-desktop"
						class="clear-filter-btn"
						title={t('blog.clearTags')}
						style="visibility: hidden; opacity: 0; pointer-events: none;"
					>
						<Icon name="ph:x" class="w-3.5 h-3.5" />
					</button>
				</div>
				<ul class="tags-list">
					{sortedTags.map(({ tag, count }) => (
						<li>
							<button
								class="blog-tag"
								data-tag={tag}
							>
								<span class="tag-name">{tag}</span>
								<span class="tag-count">{count}</span>
							</button>
						</li>
					))}
				</ul>
			</section>
		)}

		<!-- Row-style post index (no card container) -->
		<section class="post-index" aria-label={t('blog.posts')}>
			{posts.map((post) => (
				<a
					href={getRelativeLocaleUrl(lang, `/blog/${getPostBaseId(post)}/`)}
					class="post-row"
					data-tags={(post.data.tags || []).join(',')}
					data-year={post.data.pubDate.getFullYear()}
					data-month={post.data.pubDate.getMonth() + 1}
				>
					<span class="bloom" aria-hidden="true"></span>
					<time class="post-date font-mono" datetime={post.data.pubDate.toISOString()}>
						{indexDate(post.data.pubDate)}
					</time>
					<span class="post-title">{post.data.title}</span>
					{(post.data.tags || []).length > 0 && (
						<span class="post-tags" aria-hidden="true">
							{(post.data.tags || []).slice(0, 3).map((tag) => (
								<span class="tag-pill font-mono">{tag}</span>
							))}
						</span>
					)}
				</a>
			))}
		</section>

		<!-- Desktop Date Filter Sidebar (Right) - sticker pills -->
		{sortedDateGroups.length > 0 && (
			<aside class="date-filter hidden xl:block xl:sticky xl:top-4 xl:self-start">
				<div class="date-filter-header">
					<div class="flex items-center gap-2">
						<Icon name="ph:calendar-blank" class="w-4 h-4 text-accent-2" />
						<span>{archiveLabel}</span>
					</div>
					<button
						id="clear-date-filter-desktop"
						class="clear-filter-btn"
						title={t('blog.clearDate')}
						style="visibility: hidden; opacity: 0; pointer-events: none;"
					>
						<Icon name="ph:x" class="w-3.5 h-3.5" />
					</button>
				</div>
				<nav class="date-filter-nav">
					<ul class="date-list">
						{sortedDateGroups.map(({ year, count, months }, index) => (
							<li class="year-group">
								<button
									class="year-button"
									data-year={year}
									data-expanded={index === 0 ? 'true' : 'false'}
								>
									<span class="year-indicator">›</span>
									<span class="year-label font-mono">{year}</span>
									<span class="year-count">{count}</span>
								</button>
								<ul class="month-list" style={index === 0 ? '' : 'display: none;'}>
									{months.map(({ month, count }) => (
										<li>
											<button
												class="month-button"
												data-year={year}
												data-month={month}
											>
												<span class="month-name">{monthNames[month - 1]}</span>
												<span class="month-count">{count}</span>
											</button>
										</li>
									))}
								</ul>
							</li>
						))}
					</ul>
				</nav>
			</aside>
		)}
	</div>
</PageLayout>

<style>
	/* ===== Page header ===== */
	.blog-hero {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		flex-wrap: wrap;
		padding: 0 0.25rem;
		margin-bottom: 1.5rem;
	}

	.blog-hero-title {
		margin: 0;
		font-size: 2rem;
		line-height: 1.1;
		color: var(--color-foreground);
		letter-spacing: 0.02em;
	}

	.blog-hero-hand {
		margin: 0;
		font-size: 1.25rem;
		color: var(--color-foreground-secondary);
		transform: rotate(-2deg);
	}

	.panel-title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--color-foreground);
	}

	/* ===== Sticker tag pills ===== */
	.tags-list {
		display: flex;
		flex-direction: row;
		align-items: center;
		flex-wrap: wrap;
		list-style-type: none;
		margin: 0;
		padding: 0;
		gap: 0.5rem;
	}

	.blog-tag {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.25rem 0.75rem;
		background: var(--color-surface);
		color: var(--color-foreground);
		text-decoration: none;
		border: 2px solid var(--color-border);
		border-radius: 100px;
		cursor: pointer;
		transition: border-color 200ms ease, background-color 200ms ease, color 200ms ease, transform 300ms var(--ease-pop);
		font-size: 0.8125rem;
	}

	@media (hover: hover) {
		.blog-tag:hover,
		.blog-tag:focus-visible {
			border-color: var(--color-accent-2);
			transform: translateY(-1px);
		}
	}

	.blog-tag.active {
		border-color: var(--color-accent-2);
		background: color-mix(in srgb, var(--color-accent-2) 30%, var(--color-surface));
		font-weight: 600;
	}

	.tag-count {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		padding: 0.0625rem 0.375rem;
		border-radius: 100px;
		background: color-mix(in srgb, var(--color-foreground) 10%, transparent);
		font-weight: 600;
		min-width: 1rem;
		text-align: center;
	}

	.blog-tag.active .tag-count {
		background: color-mix(in srgb, var(--color-accent-2) 45%, transparent);
	}

	/* ===== Row-style post index ===== */
	.post-index {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.post-row {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		padding: 0.875rem 0.75rem;
		border-bottom: 1px solid var(--color-border);
		text-decoration: none;
		position: relative;
		overflow: hidden;
	}

	.post-row:last-child {
		border-bottom: none;
	}

	/* Circle bloom — grows from the pointer position */
	.bloom {
		position: absolute;
		left: var(--bloom-x, 50%);
		top: var(--bloom-y, 50%);
		width: 2rem;
		height: 2rem;
		border-radius: 9999px;
		background: color-mix(in srgb, var(--color-accent-2) 38%, transparent);
		transform: translate(-50%, -50%) scale(0);
		transition: transform 550ms var(--ease-out);
		pointer-events: none;
		z-index: 0;
	}

	@media (hover: hover) {
		.post-row:hover .bloom,
		.post-row:focus-visible .bloom {
			transform: translate(-50%, -50%) scale(40);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.bloom {
			transition: none;
		}
	}

	.post-date {
		position: relative;
		z-index: 1;
		flex-shrink: 0;
		font-size: 0.75rem;
		color: var(--color-foreground-secondary);
		letter-spacing: 0.02em;
		min-width: 5.5rem;
	}

	.post-title {
		position: relative;
		z-index: 1;
		flex: 1;
		min-width: 0;
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--color-foreground);
		line-height: 1.5;
		transition: transform 300ms var(--ease-out), color 200ms ease;
	}

	@media (hover: hover) {
		.post-row:hover .post-title,
		.post-row:focus-visible .post-title {
			transform: translateX(0.375rem);
		}
	}

	.post-tags {
		position: relative;
		z-index: 1;
		display: none;
		align-items: center;
		gap: 0.375rem;
		flex-shrink: 0;
	}

	@media (min-width: 640px) {
		.post-tags {
			display: flex;
		}
	}

	.tag-pill {
		font-size: 0.6875rem;
		padding: 0.125rem 0.625rem;
		border: 1px solid var(--color-border);
		border-radius: 100px;
		color: var(--color-foreground-secondary);
		background: color-mix(in srgb, var(--color-surface) 60%, transparent);
		white-space: nowrap;
	}

	/* ===== Blog Layout - Three Column on XL screens ===== */
	.blog-layout {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;
	}

	@media (min-width: 1024px) {
		.blog-layout {
			grid-template-columns: 1fr 2fr;
			gap: 1.5rem;
		}
	}

	@media (min-width: 1280px) {
		.blog-layout {
			grid-template-columns: 1fr 2fr 274px;
			gap: 1.5rem;
		}
	}

	@media (min-width: 1536px) {
		.blog-layout {
			grid-template-columns: 1fr 2fr 320px;
			gap: 2rem;
		}
	}

	/* ===== Date Filter Sidebar - sticker pills ===== */
	.date-filter {
		position: relative;
		color: var(--color-foreground);
		font-size: 0.875rem;
	}

	.date-filter-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		font-weight: 600;
		margin-bottom: 1rem;
		color: var(--color-foreground);
		font-size: 0.875rem;
	}

	.date-filter-nav {
		width: 100%;
		font-size: 0.875rem;
	}

	.date-list {
		list-style-type: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.year-group {
		list-style-type: none;
	}

	.year-button {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.375rem 0.75rem;
		background: var(--color-surface);
		color: var(--color-foreground);
		border: 2px solid var(--color-border);
		border-radius: 100px;
		cursor: pointer;
		transition: border-color 200ms ease, background-color 200ms ease, color 200ms ease;
		font-size: 0.875rem;
		font-weight: 600;
		width: 100%;
	}

	@media (hover: hover) {
		.year-button:hover {
			border-color: var(--color-accent-2);
		}
	}

	.year-indicator {
		color: var(--color-accent-2);
		font-weight: 700;
		transition: transform 200ms var(--ease-pop);
		display: inline-block;
		width: 1rem;
		text-align: center;
	}

	.year-button[data-expanded="true"] .year-indicator {
		transform: rotate(90deg);
	}

	.year-label {
		flex: 1;
		text-align: left;
		font-size: 0.8125rem;
	}

	.year-count {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		padding: 0.125rem 0.5rem;
		border-radius: 100px;
		background: color-mix(in srgb, var(--color-foreground) 10%, transparent);
		font-weight: 600;
		min-width: 1.5rem;
		text-align: center;
	}

	/* Month List */
	.month-list {
		list-style-type: none;
		margin: 0.375rem 0 0 0;
		padding: 0 0 0 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}

	.month-button {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.25rem 0.75rem;
		background: transparent;
		color: var(--color-foreground-secondary);
		border: 2px solid transparent;
		border-radius: 100px;
		cursor: pointer;
		transition: border-color 200ms ease, background-color 200ms ease, color 200ms ease;
		font-size: 0.8125rem;
		width: 100%;
	}

	@media (hover: hover) {
		.month-button:hover {
			border-color: var(--color-accent-2);
			color: var(--color-foreground);
		}
	}

	.month-button.active {
		border-color: var(--color-accent-2);
		background: color-mix(in srgb, var(--color-accent-2) 25%, transparent);
		color: var(--color-foreground);
		font-weight: 600;
	}

	.month-name {
		flex: 1;
		text-align: left;
	}

	.month-count {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		padding: 0.0625rem 0.5rem;
		border-radius: 100px;
		background: color-mix(in srgb, var(--color-foreground) 10%, transparent);
		font-weight: 600;
		min-width: 1.25rem;
		text-align: center;
	}

	.month-button.active .month-count {
		background: color-mix(in srgb, var(--color-accent-2) 45%, transparent);
	}

	/* Clear Filter Button */
	.clear-filter-btn {
		padding: 0.25rem;
		background: transparent;
		border: 2px solid transparent;
		border-radius: 100px;
		color: var(--color-foreground-secondary);
		cursor: pointer;
		transition: border-color 200ms ease, color 200ms ease;
		display: flex;
		align-items: center;
		justify-content: center;
		min-width: 1.75rem;
		min-height: 1.75rem;
	}

	.clear-filter-btn:hover {
		border-color: var(--color-accent-2);
		color: var(--color-foreground);
	}

	/* Year button active state (when year is selected) */
	.year-button.active {
		border-color: var(--color-accent-2);
		background: color-mix(in srgb, var(--color-accent-2) 25%, var(--color-surface));
	}

	.year-button.active .year-count {
		background: color-mix(in srgb, var(--color-accent-2) 45%, transparent);
	}
</style>

<script>
	const tags = document.querySelectorAll<HTMLButtonElement>('.blog-tag');
	const postRows = document.querySelectorAll<HTMLAnchorElement>('.post-row');
	const url = new URL(window.location.href);
	const initialTags = url.searchParams.get('tags')?.split(',').filter((tag) => tag.length > 0) || [];
	const selectedTags = new Set(initialTags);

	// Tag filter elements
	const clearTagsDesktop = document.getElementById('clear-tags-filter-desktop');
	const clearTagsMobile = document.getElementById('clear-tags-filter-mobile');

	// Date filter state
	const initialYear = url.searchParams.get('year');
	const initialMonth = url.searchParams.get('month');
	let selectedYear: number | null = initialYear ? parseInt(initialYear) : null;
	let selectedMonth: number | null = initialMonth ? parseInt(initialMonth) : null;

	// Date filter elements
	const yearButtons = document.querySelectorAll<HTMLButtonElement>('.year-button');
	const monthButtons = document.querySelectorAll<HTMLButtonElement>('.month-button');

	// Mobile filter controls
	const mobileFilterBtn = document.getElementById('mobile-filter-btn');
	const mobileFilterOverlay = document.getElementById('mobile-filter-overlay');
	const mobileFilterClose = document.getElementById('mobile-filter-close');

	// Circle bloom: track the pointer so the circle grows from the hover point
	postRows.forEach((row) => {
		const setBloomOrigin = (e: MouseEvent) => {
			const rect = row.getBoundingClientRect();
			row.style.setProperty('--bloom-x', `${e.clientX - rect.left}px`);
			row.style.setProperty('--bloom-y', `${e.clientY - rect.top}px`);
		};
		row.addEventListener('mouseenter', setBloomOrigin);
		row.addEventListener('mouseleave', setBloomOrigin);
	});

	function openMobileFilter() {
		if (mobileFilterOverlay) {
			mobileFilterOverlay.classList.remove('pointer-events-none', 'opacity-0');
			mobileFilterOverlay.classList.add('pointer-events-auto', 'opacity-100');
			document.body.style.overflow = 'hidden';
		}
	}

	function closeMobileFilter() {
		if (mobileFilterOverlay) {
			mobileFilterOverlay.classList.add('pointer-events-none', 'opacity-0');
			mobileFilterOverlay.classList.remove('pointer-events-auto', 'opacity-100');
			document.body.style.overflow = '';
		}
	}

	function toggleMobileFilter() {
		if (mobileFilterOverlay?.classList.contains('pointer-events-none')) {
			openMobileFilter();
		} else {
			closeMobileFilter();
		}
	}

	mobileFilterBtn?.addEventListener('click', toggleMobileFilter);
	mobileFilterClose?.addEventListener('click', closeMobileFilter);

	// Close on overlay click (but not on content click)
	mobileFilterOverlay?.addEventListener('click', (e) => {
		if (e.target === mobileFilterOverlay) {
			closeMobileFilter();
		}
	});

	function updateTagClearButtonVisibility() {
		const hasTagFilter = selectedTags.size > 0;
		if (clearTagsDesktop) {
			clearTagsDesktop.style.visibility = hasTagFilter ? 'visible' : 'hidden';
			clearTagsDesktop.style.opacity = hasTagFilter ? '1' : '0';
			clearTagsDesktop.style.pointerEvents = hasTagFilter ? 'auto' : 'none';
		}
		if (clearTagsMobile) {
			clearTagsMobile.style.visibility = hasTagFilter ? 'visible' : 'hidden';
			clearTagsMobile.style.opacity = hasTagFilter ? '1' : '0';
			clearTagsMobile.style.pointerEvents = hasTagFilter ? 'auto' : 'none';
		}
	}

	function clearTagFilter() {
		selectedTags.clear();
		tags.forEach((tag) => tag.classList.remove('active'));
		updatePostsVisibility();
		updateURL();
		updateTagClearButtonVisibility();
	}

	// Close on escape key
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') {
			closeMobileFilter();
		}
	});

	// Hide button while scrolling, show when stopped
	let isScrolling = false;
	let scrollStopTimer: ReturnType<typeof setTimeout> | null = null;

	window.addEventListener('scroll', () => {
		// Hide button immediately when scrolling starts
		if (!isScrolling && mobileFilterBtn) {
			isScrolling = true;
			mobileFilterBtn.style.transform = 'translateX(-85%)';
		}

		// Clear previous timer
		if (scrollStopTimer) {
			clearTimeout(scrollStopTimer);
		}

		// Show button after scrolling stops
		scrollStopTimer = setTimeout(() => {
			isScrolling = false;
			if (mobileFilterBtn) {
				mobileFilterBtn.style.transform = 'translateX(0)';
			}
		}, 150);
	});

	function updatePostsVisibility() {
		postRows.forEach((post) => {
			const postTags = post.dataset.tags!.split(',').filter(t => t.length > 0);
			const postYear = parseInt(post.dataset.year!);
			const postMonth = parseInt(post.dataset.month!);

			let matchesTags = true;
			let matchesDate = true;

			// Check tags filter
			if (selectedTags.size > 0) {
				matchesTags = [...selectedTags].every((tag) => postTags.includes(tag));
			}

			// Check date filter
			if (selectedYear !== null) {
				if (selectedMonth !== null) {
					// Both year and month selected
					matchesDate = postYear === selectedYear && postMonth === selectedMonth;
				} else {
					// Only year selected
					matchesDate = postYear === selectedYear;
				}
			}

			// Show only if matches both filters (AND logic)
			if (matchesTags && matchesDate) {
				post.style.display = '';
			} else {
				post.style.display = 'none';
			}
		});
	}

	function updateURL() {
		const newUrl = new URL(window.location.pathname, window.location.origin);
		if (selectedTags.size > 0) {
			newUrl.searchParams.set('tags', [...selectedTags].join(','));
		}
		if (selectedYear !== null) {
			newUrl.searchParams.set('year', selectedYear.toString());
		}
		if (selectedMonth !== null) {
			newUrl.searchParams.set('month', selectedMonth.toString());
		}
		history.pushState({}, '', newUrl);
	}

	tags.forEach((tag) => {
		const tagValue = tag.dataset.tag!;
		if (selectedTags.has(tagValue)) {
			tag.classList.add('active');
		}

		tag.addEventListener('click', (event) => {
			event.preventDefault();

			tag.classList.toggle('active');

			if (selectedTags.has(tagValue)) {
				selectedTags.delete(tagValue);
			} else {
				selectedTags.add(tagValue);
			}

			updatePostsVisibility();
			updateURL();
			updateTagClearButtonVisibility();
		});
	});

	// Clear tag filter buttons
	clearTagsDesktop?.addEventListener('click', clearTagFilter);
	clearTagsMobile?.addEventListener('click', clearTagFilter);

	// Clear date filter buttons
	const clearDateDesktop = document.getElementById('clear-date-filter-desktop');
	const clearDateMobile = document.getElementById('clear-date-filter-mobile');

	function updateClearButtonVisibility() {
		const isDateFilterActive = selectedYear !== null;
		if (clearDateDesktop) {
			clearDateDesktop.style.visibility = isDateFilterActive ? 'visible' : 'hidden';
			clearDateDesktop.style.opacity = isDateFilterActive ? '1' : '0';
			clearDateDesktop.style.pointerEvents = isDateFilterActive ? 'auto' : 'none';
		}
		if (clearDateMobile) {
			clearDateMobile.style.visibility = isDateFilterActive ? 'visible' : 'hidden';
			clearDateMobile.style.opacity = isDateFilterActive ? '1' : '0';
			clearDateMobile.style.pointerEvents = isDateFilterActive ? 'auto' : 'none';
		}
	}

	function updateYearButtonStates() {
		yearButtons.forEach((btn) => {
			const year = parseInt(btn.dataset.year!);
			if (selectedYear === year && selectedMonth === null) {
				btn.classList.add('active');
			} else {
				btn.classList.remove('active');
			}
		});
	}

	function clearDateFilter() {
		selectedYear = null;
		selectedMonth = null;
		monthButtons.forEach(btn => btn.classList.remove('active'));
		updateYearButtonStates();
		updateClearButtonVisibility();
		updatePostsVisibility();
		updateURL();
	}

	// Clear button event listeners
	clearDateDesktop?.addEventListener('click', clearDateFilter);
	clearDateMobile?.addEventListener('click', clearDateFilter);

	// Year button interactions - click year to filter + expand (accordion effect)
	yearButtons.forEach((yearBtn) => {
		const year = parseInt(yearBtn.dataset.year!);
		const monthList = yearBtn.nextElementSibling as HTMLElement;

		// Set initial active state
		if (selectedYear === year && selectedMonth === null) {
			yearBtn.classList.add('active');
			yearBtn.dataset.expanded = 'true';
			if (monthList) monthList.style.display = '';
		}

		// Click anywhere on year button
		yearBtn.addEventListener('click', (e) => {
			e.preventDefault();
			const isExpanded = yearBtn.dataset.expanded === 'true';
			const isSameYear = selectedYear === year && selectedMonth === null;

			// Accordion effect: close all other years
			yearButtons.forEach(btn => {
				const otherYear = parseInt(btn.dataset.year!);
				if (otherYear !== year) {
					btn.dataset.expanded = 'false';
					const otherMonthList = btn.nextElementSibling as HTMLElement;
					if (otherMonthList) otherMonthList.style.display = 'none';
				}
			});

			// If clicking the same year that's already selected, deselect and collapse
			if (isSameYear && isExpanded) {
				selectedYear = null;
				selectedMonth = null;
				yearBtn.dataset.expanded = 'false';
				if (monthList) monthList.style.display = 'none';
			} else {
				// Select this year and expand
				monthButtons.forEach(btn => btn.classList.remove('active'));
				selectedYear = year;
				selectedMonth = null;
				yearBtn.dataset.expanded = 'true';
				if (monthList) monthList.style.display = '';
			}

			updateYearButtonStates();
			updateClearButtonVisibility();
			updatePostsVisibility();
			updateURL();
		});
	});

	// Month button interactions
	monthButtons.forEach((monthBtn) => {
		const year = parseInt(monthBtn.dataset.year!);
		const month = parseInt(monthBtn.dataset.month!);

		// Set initial active state
		if (selectedYear === year && selectedMonth === month) {
			monthBtn.classList.add('active');
		}

		monthBtn.addEventListener('click', (e) => {
			e.preventDefault();

			// If clicking the same month, deselect it
			if (selectedYear === year && selectedMonth === month) {
				selectedYear = null;
				selectedMonth = null;
				monthBtn.classList.remove('active');
			} else {
				// Deselect all months first
				monthButtons.forEach(btn => btn.classList.remove('active'));

				// Select this month
				selectedYear = year;
				selectedMonth = month;
				monthBtn.classList.add('active');
			}

			updateYearButtonStates();
			updateClearButtonVisibility();
			updatePostsVisibility();
			updateURL();
		});
	});

	// Initialize
	updateTagClearButtonVisibility();
	updateClearButtonVisibility();
	updateYearButtonStates();
	updatePostsVisibility();
</script>
