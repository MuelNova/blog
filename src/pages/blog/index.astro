---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.unlisted)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<PageLayout 
	title={SITE_TITLE} 
	description={SITE_DESCRIPTION}
	class="w-full max-w-[960px] mx-auto py-8 px-4"
>
	<section>
		<ul class="flex flex-wrap gap-8 list-none m-0 p-0">
					{
						posts.map((post, index) => (
							<li class={index === 0 ? "w-full mb-4 text-center" : "w-full md:w-[calc(50%-1rem)]"}>
								<a 
									href={`/blog/${post.id}/`}
									class="block no-underline group transition-all duration-200"
								>
									{post.data.heroImage && (
										<Image 
											width={720} 
											height={360} 
											src={post.data.heroImage} 
											alt="" 
											class="mb-2 rounded-xl group-hover:shadow-[0_4px_12px_rgba(var(--color-primary-rgb),0.3)] transition-shadow duration-200"
										/>
									)}
									<h4 class={`m-0 text-foreground leading-tight group-hover:text-primary transition-colors duration-200 ${index === 0 ? 'text-4xl' : 'text-xl'}`}>
										{post.data.title}
									</h4>
									<p class="m-0 text-foreground/70 group-hover:text-primary transition-colors duration-200 mt-2">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
					))
				}
			</ul>
		</section>
</PageLayout>