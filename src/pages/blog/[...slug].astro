---
import { type CollectionEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getAllPostsWithPreferredLang as getCollectionWithPreferredLang, getPostBaseId } from '../../i18n/i18n';
import { defaultLang } from '../../i18n/config';

export async function getStaticPaths() {
  const posts = await getCollectionWithPreferredLang(defaultLang);
  
  return posts.map(post => ({
    params: { slug: getPostBaseId(post) },
    props: { post },
  }));
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content, headings } = await render(post);

// Estimate reading time: ~400 CJK chars/min and ~200 latin words/min.
const body = post.body ?? '';
const cjkCount = (body.match(/[\u4e00-\u9fff\u3400-\u4dbf]/g) ?? []).length;
const latinWords = (body.replace(/[\u4e00-\u9fff\u3400-\u4dbf]/g, ' ').match(/[A-Za-z0-9]+/g) ?? []).length;
const readingTimeMinutes = Math.max(1, Math.ceil(cjkCount / 400 + latinWords / 200));
---

<BlogPost {...post.data} headings={headings} readingTimeMinutes={readingTimeMinutes}>
	<Content />
</BlogPost>
