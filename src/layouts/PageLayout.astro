---
/**
 * PageLayout
 * Unified page layout with header and footer
 * Replaces repetitive HTML structure across pages
 */

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Background from '../components/Background.astro';

interface Props {
	title: string;
	description: string;
	class?: string;
	showFooter?: boolean;
}

const { title, description, class: className, showFooter = false } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body class="font-sans">
		<slot name="overlay" />
		<Background />
		<Header />
		<main class={className}>
			<slot />
		</main>
		{showFooter && <Footer />}
	</body>
</html>
