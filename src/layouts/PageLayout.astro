---
/**
 * PageLayout
 * Unified page layout with header and footer
 * Replaces repetitive HTML structure across pages
 */

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Background from '../components/Background.astro';
import MarqueeDivider from '../components/MarqueeDivider.astro';
import { defaultLang, resolveLang } from '../i18n/config';

interface Props {
	title: string;
	description: string;
	class?: string;
	showFooter?: boolean;
	/** 页脚上方跑马灯分隔带，默认开启；首页自挂两条时关闭 */
	showMarquee?: boolean;
	lang?: string;
}

const { title, description, class: className, showFooter = false, showMarquee = true, lang: langProp } = Astro.props;
const lang = langProp ?? resolveLang(Astro.url.pathname) ?? defaultLang;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body class="font-sans">
		<slot name="overlay" />
		<Background />
		<Header lang={lang} />
		<main class={className}>
			<slot />
		</main>
		{showMarquee && <MarqueeDivider />}
		{showFooter && <Footer lang={lang} />}
		<script>
			// Lenis 全站平滑滚动（通用逻辑，reduced-motion 时不启用）
			// gsap.ticker 驱动 lenis.raf，lagSmoothing(0) 避免与 GSAP 时间轴冲突
			import Lenis from 'lenis';
			import gsap from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';

			gsap.registerPlugin(ScrollTrigger);

			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (!reduceMotion) {
				const lenis = new Lenis({ lerp: 0.1 });
				lenis.on('scroll', ScrollTrigger.update);
				gsap.ticker.add((time) => {
					lenis.raf(time * 1000);
				});
				gsap.ticker.lagSmoothing(0);
				// 暴露给 MarqueeDivider 等彩蛋读取滚动速度
				(window as unknown as { __lenis?: Lenis }).__lenis = lenis;
			}
		</script>
	</body>
</html>
