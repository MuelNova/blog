---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Background from '../components/Background.astro';
import Giscus from '../components/Giscus.astro';
import MarqueeDivider from '../components/MarqueeDivider.astro';
import ShareButton from '../components/ShareButton.astro';
import { defaultLang, resolveLang, useTranslations, type Lang } from '../i18n/config';

type Props = Partial<CollectionEntry<'blog'>['data']> & {
	title: string;
	description: string;
	headings?: any[];
	showTitle?: boolean;
  	lang?: Lang;
	/** Optional estimated reading time in minutes (computed by the caller). */
	readingTimeMinutes?: number;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	headings = [],
	showTitle = true,
	lang: langProp,
	tags = [],
	readingTimeMinutes,
} = Astro.props;
const lang = langProp ?? resolveLang(Astro.url.pathname) ?? defaultLang;
const t = useTranslations(lang);

const readingTimeLabel =
	typeof readingTimeMinutes === 'number' && readingTimeMinutes > 0
		? lang === 'zh'
			? `约 ${readingTimeMinutes} 分钟`
			: `${readingTimeMinutes} min read`
		: null;
---

<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Background />
		<Header lang={lang} />
		<main class="blog-post-main-with-toc">
			<article class="blog-article-wrapper">
				{heroImage && (
					<div class="hero-image blog-post-hero">
						<Image width={1020} height={510} src={heroImage} alt="" />
					</div>
				)}
				<div class="prose blog-post-prose">
					{(showTitle || pubDate || updatedDate) && (
						<div class="title blog-post-title">
							{(pubDate || updatedDate || readingTimeLabel) && (
								<div class="date blog-post-date">
									{pubDate && <FormattedDate date={pubDate} lang={lang} />}
									{readingTimeLabel && (
										<span class="blog-post-reading-time">· {readingTimeLabel}</span>
									)}
									{updatedDate && (
										<div class="last-updated-on blog-post-last-updated">
											{t('blog.lastUpdated')} <FormattedDate date={updatedDate} lang={lang} />
										</div>
									)}
								</div>
							)}
							{showTitle && <h1>{title}</h1>}
							{tags.length > 0 && (
								<div class="blog-post-tags">
									{tags.map((tag) => <span class="blog-post-tag">{tag}</span>)}
								</div>
							)}
							{showTitle && <hr />}
						</div>
					)}
					<slot />
				</div>
			</article>
			<TableOfContents headings={headings} lang={lang} />
		</main>
		<ShareButton lang={lang} />
		<Giscus />
		<MarqueeDivider />
		<Footer lang={lang} />
	</body>
</html>

<style>
	/* Hero cover — sticker frame */
	:global(.hero-image.blog-post-hero img) {
		border-radius: var(--radius-card);
		border: 2px solid var(--color-border);
	}

	/* Article title — cute display font */
	:global(.blog-post-title h1) {
		font-family: var(--font-display);
		font-weight: 700;
		line-height: 1.25;
	}

	/* Meta row — small mono type */
	:global(.prose .blog-post-date) {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--color-foreground-secondary);
	}

	:global(.prose .blog-post-reading-time) {
		color: var(--color-foreground-secondary);
	}

	:global(.prose .blog-post-last-updated) {
		font-style: normal;
		font-size: 0.75rem;
	}

	/* Tag pills */
	.blog-post-tags {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 0.75rem;
	}

	.blog-post-tag {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		padding: 0.25rem 0.875rem;
		border-radius: var(--radius-pill);
		border: 2px solid var(--color-border);
		background: var(--color-surface);
		color: var(--color-foreground-secondary);
	}

	/* Title divider — soft and short */
	:global(.prose .blog-post-title hr) {
		max-width: 12rem;
		margin: 1.5rem auto 0;
		background: color-mix(in srgb, var(--color-primary) 45%, transparent);
	}

	/* Giscus comment area — rounded sticker container */
	:global(.giscus-container) {
		border: 2px solid var(--color-border);
		border-radius: var(--radius-card);
		background: var(--color-surface);
		padding: 1rem 1.25rem;
		overflow: hidden;
	}
</style>
