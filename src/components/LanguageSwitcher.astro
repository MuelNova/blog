---
import { defaultLang, languages, pathHasLocale, prefixDefaultLocale } from '../i18n/config';
import type { Lang } from '../i18n/config';
import { Icon } from 'astro-icon/components';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const pathname = Astro.url?.pathname || '/';
const entries = Object.entries(languages) as [Lang, string][];
const currentLabel = languages[lang] ?? lang;

const localeHref = (path: string, target: Lang) => {
  const current = path || '/';
  const base = current.startsWith('/') ? current : `/${current}`;
  const segments = base.split('/').filter(Boolean);
  
  // Strip existing locale segment if present
  if (segments[0] && Object.hasOwn(languages, segments[0])) {
    segments.shift();
  }
  const normalized = '/' + segments.join('/');
  const isRoot = normalized === '/';

  // Default locale without prefix when prefixDefaultLocale is false.
  if (target === defaultLang && !prefixDefaultLocale) {
    return normalized;
  }

  return `/${target}${isRoot ? '' : normalized}`;
};
---
<div class="lang-switcher">
  <button class="lang-trigger" aria-haspopup="listbox" aria-expanded="false">
    <Icon name="ph:globe-simple" class="lang-icon" />
    <span class="lang-label">{currentLabel}</span>
    <Icon name="ph:caret-down" class="lang-caret" />
  </button>
  <ul class="lang-menu" role="listbox">
    {entries.map(([code, label]) => {
      const href = localeHref(pathname, code);
      const isActive = code === lang;
      return (
        <li>
          <a
            href={href}
            role="option"
            aria-selected={isActive}
            class:list={['lang-item', { active: isActive }]}
          >
            <span class="lang-code">{code.toUpperCase()}</span>
            <span class="lang-name">{label}</span>
            {isActive && <Icon name="ph:check" class="lang-check" />}
          </a>
        </li>
      );
    })}
  </ul>
</div>

<script>
  function initLangSwitcher() {
    const switchers = document.querySelectorAll('.lang-switcher');
    
    switchers.forEach((switcher) => {
      const trigger = switcher.querySelector('.lang-trigger') as HTMLButtonElement;
      const menu = switcher.querySelector('.lang-menu') as HTMLUListElement;
      
      if (!trigger || !menu) return;
      
      const toggle = (open?: boolean) => {
        const isOpen = open ?? trigger.getAttribute('aria-expanded') !== 'true';
        trigger.setAttribute('aria-expanded', String(isOpen));
        switcher.classList.toggle('open', isOpen);
      };
      
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        toggle();
      });
      
      // Close on click outside
      document.addEventListener('click', (e) => {
        if (!switcher.contains(e.target as Node)) {
          toggle(false);
        }
      });
      
      // Close on Escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          toggle(false);
          trigger.focus();
        }
      });
    });
  }
  
  // Initialize on page load
  initLangSwitcher();
  
  // Re-initialize on Astro page transitions
  document.addEventListener('astro:page-load', initLangSwitcher);
</script>

<style>
  .lang-switcher {
    position: relative;
    display: inline-flex;
  }

  /* Trigger Button */
  .lang-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    border: 1px solid color-mix(in srgb, var(--color-accent) 40%, transparent);
    background: color-mix(in srgb, var(--color-accent) 5%, transparent);
    color: color-mix(in srgb, var(--color-foreground) 85%, transparent);
    cursor: pointer;
    user-select: none;
    transition: all 150ms ease;
  }

  .lang-trigger:hover {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-foreground);
    box-shadow: 0 0 12px color-mix(in srgb, var(--color-accent) 20%, transparent);
  }

  .lang-trigger:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .lang-switcher.open .lang-trigger {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    box-shadow: 0 0 16px color-mix(in srgb, var(--color-accent) 25%, transparent);
  }

  /* Icon styles */
  .lang-icon {
    width: 1rem;
    height: 1rem;
    color: var(--color-accent);
    filter: drop-shadow(0 0 4px var(--color-accent));
  }

  .lang-label {
    line-height: 1.2;
  }

  .lang-caret {
    width: 0.75rem;
    height: 0.75rem;
    color: color-mix(in srgb, var(--color-foreground) 50%, transparent);
    transition: transform 200ms ease, color 150ms ease;
  }

  .lang-switcher.open .lang-caret {
    transform: rotate(180deg);
    color: var(--color-accent);
  }

  /* Dropdown Menu */
  .lang-menu {
    position: absolute;
    top: calc(100% + 0.375rem);
    right: 0;
    min-width: 10rem;
    padding: 0.375rem;
    margin: 0;
    list-style: none;
    background: var(--color-background);
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    box-shadow: 
      0 4px 24px color-mix(in srgb, #000 40%, transparent),
      0 0 1px color-mix(in srgb, var(--color-accent) 30%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--color-foreground) 5%, transparent);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px) scale(0.98);
    transform-origin: top right;
    transition: 
      opacity 150ms ease,
      transform 150ms ease,
      visibility 150ms ease;
    z-index: 100;
  }

  .lang-switcher.open .lang-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  /* Menu Items */
  .lang-menu li {
    margin: 0;
    padding: 0;
  }

  .lang-menu li + li {
    margin-top: 0.125rem;
  }

  .lang-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.625rem;
    text-decoration: none;
    color: color-mix(in srgb, var(--color-foreground) 75%, transparent);
    font-size: 0.8125rem;
    border: 1px solid transparent;
    transition: all 120ms ease;
  }

  .lang-item:hover {
    color: var(--color-foreground);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    border-color: color-mix(in srgb, var(--color-accent) 25%, transparent);
  }

  .lang-item:focus-visible {
    outline: none;
    color: var(--color-foreground);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    border-color: var(--color-accent);
  }

  .lang-item.active {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
  }

  .lang-item.active:hover {
    background: color-mix(in srgb, var(--color-accent) 15%, transparent);
    box-shadow: 0 0 8px color-mix(in srgb, var(--color-accent) 15%, transparent);
  }

  /* Language code badge */
  .lang-code {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.75rem;
    padding: 0.125rem 0.375rem;
    font-size: 0.6875rem;
    font-weight: 600;
    font-family: var(--font-mono, monospace);
    letter-spacing: 0.05em;
    background: color-mix(in srgb, var(--color-foreground) 8%, transparent);
    color: color-mix(in srgb, var(--color-foreground) 60%, transparent);
    transition: all 120ms ease;
  }

  .lang-item:hover .lang-code,
  .lang-item:focus-visible .lang-code {
    background: color-mix(in srgb, var(--color-accent) 15%, transparent);
    color: var(--color-accent);
  }

  .lang-item.active .lang-code {
    background: color-mix(in srgb, var(--color-accent) 20%, transparent);
    color: var(--color-accent);
  }

  .lang-name {
    flex: 1;
  }

  .lang-check {
    width: 0.875rem;
    height: 0.875rem;
    color: var(--color-accent);
    filter: drop-shadow(0 0 4px var(--color-accent));
  }

  /* Mobile styles */
  @media (max-width: 640px) {
    .lang-switcher {
      width: 100%;
    }

    .lang-trigger {
      width: 100%;
      justify-content: flex-start;
      padding: 0.5rem 0.875rem;
      font-size: 0.875rem;
    }

    .lang-label {
      flex: 1;
    }

    .lang-menu {
      position: static;
      width: 100%;
      margin-top: 0.5rem;
      transform: none;
      opacity: 1;
      visibility: visible;
      max-height: 0;
      overflow: hidden;
      padding: 0;
      border: none;
      box-shadow: none;
      background: transparent;
      transition: max-height 200ms ease, padding 200ms ease, border 200ms ease;
    }

    .lang-switcher.open .lang-menu {
      max-height: 300px;
      padding: 0.375rem;
      border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
    }

    .lang-item {
      padding: 0.625rem 0.75rem;
      font-size: 0.875rem;
    }
  }
</style>
