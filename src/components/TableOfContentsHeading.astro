---
import type { MarkdownHeading } from 'astro'

interface Props {
  heading: MarkdownHeading
}

const {
  heading: { depth, slug, text },
} = Astro.props

const indent = Math.max(0, depth - 2)
---

<li class="toc-item" style={`--toc-indent: ${indent}`}>
  <a class="toc-link" href={`#${slug}`}>
    <span class="toc-dot" aria-hidden="true"></span>
    <span class="toc-text">{text}</span>
  </a>
</li>

<style>
  .toc-item {
    padding-left: calc(var(--toc-indent) * 1rem);
  }

  .toc-link {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.625rem;
    color: var(--color-foreground-secondary);
    text-decoration: none;
    transition: color 150ms ease, background-color 150ms ease;
  }

  .toc-link:hover {
    color: var(--color-foreground);
    background: color-mix(in srgb, var(--color-primary) 14%, transparent);
  }

  .toc-text {
    line-clamp: 2;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Current-heading indicator: a soft candy dot */
  .toc-dot {
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-border);
    transform: translateY(-0.0625rem);
    transition: background-color 200ms ease, transform 200ms var(--ease-pop);
  }

  li.active-heading .toc-link {
    color: var(--color-foreground);
    font-weight: 600;
  }

  li.active-heading .toc-dot {
    background: var(--color-primary);
    transform: translateY(-0.0625rem) scale(1.35);
  }
</style>
