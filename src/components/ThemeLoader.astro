---
/**
 * Theme Loader Component (Muir's Cream)
 *
 * Applies the cream / cream-dark theme before first paint (no FOUC).
 * - explicit choice (localStorage 'theme-preference' = light|dark) wins
 * - otherwise follows prefers-color-scheme and live system changes
 * - resolved theme id stays in localStorage 'theme' for theme-bus consumers
 */

import { DEFAULT_THEME_ID, THEME_STORAGE_KEY } from '../config/theme-runtime';
---

<script is:inline define:vars={{ defaultThemeId: DEFAULT_THEME_ID, themeStorageKey: THEME_STORAGE_KEY }}>
	(() => {
		try {
			const preference = localStorage.getItem('theme-preference');
			let theme;
			if (preference === 'light') {
				theme = 'cream';
			} else if (preference === 'dark') {
				theme = 'cream-dark';
			} else {
				theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'cream-dark' : 'cream';
			}
			document.documentElement.setAttribute('data-theme', theme);
		} catch {
			document.documentElement.setAttribute('data-theme', defaultThemeId);
		}
	})();
</script>

<script>
	import { DEFAULT_THEME_ID, THEME_STORAGE_KEY } from '../config/theme-runtime';
	import { ALL_THEME_IDS } from '../config/theme-client-data';
	import {
		configureThemeBus,
		getCurrentTheme,
		getThemePreference,
		isValidThemeId,
		resolveThemeForPreference,
		setCurrentTheme,
	} from '../lib/theme-bus';

	(function loadTheme() {
		configureThemeBus({
			defaultThemeId: DEFAULT_THEME_ID,
			validThemeIds: ALL_THEME_IDS,
		});

		// Persist the resolved theme so cross-tab sync and consumers
		// (e.g. Giscus) keep working.
		setCurrentTheme(getCurrentTheme(), {
			persist: true,
			source: 'theme-loader-init',
		});

		// Follow live system theme changes unless the user made an explicit choice.
		const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
		systemDark.addEventListener('change', () => {
			if (getThemePreference('system') !== 'system') return;

			setCurrentTheme(resolveThemeForPreference('system'), {
				persist: true,
				source: 'system',
			});
		});

		// Cross-tab theme synchronization
		window.addEventListener('storage', (event: StorageEvent) => {
			if (event.key === THEME_STORAGE_KEY && isValidThemeId(event.newValue)) {
				setCurrentTheme(event.newValue, {
					persist: false,
					source: 'storage-sync',
				});
				return;
			}

			if (event.key === 'theme-preference') {
				const preference = event.newValue === 'light' || event.newValue === 'dark' ? event.newValue : 'system';
				setCurrentTheme(resolveThemeForPreference(preference), {
					persist: false,
					source: 'storage-sync',
				});
			}
		});
	})();
</script>
