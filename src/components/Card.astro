---
/**
 * Card Component
 * Sticker-style card: rounded corners, 2px warm outline, no drop shadow.
 */

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={[
	'rounded-2xl border-2 border-border bg-surface p-3 md:p-6 transition-colors duration-300 hover:border-primary',
	className
]}>
	<slot />
</div>
