---
/**
 * ProfileCard Component
 * Displays user profile with avatar and quick info
 */

import Card from './Card.astro';
import { AVATAR_URL } from '../consts';

interface Props {
	name: string;
	info?: string[];
}

const { name, info = [] } = Astro.props;

const infoIcons = [
	'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z',
	'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
	'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
];
---

<Card class="flex flex-col items-center gap-3">
	<!-- Avatar with remote src + inline fallback -->
	<div class="avatar-shell">
		<img
			src={AVATAR_URL}
			alt={`${name} avatar`}
			loading="lazy"
			width="96"
			height="96"
			class="avatar-img"
			decoding="async"
			onload="const fb=this.nextElementSibling; if(fb) fb.classList.add('hide-fallback');"
			onerror="const fb=this.nextElementSibling; if(fb) fb.classList.remove('hide-fallback');"
		/>
		<div class="avatar-fallback" aria-hidden="true">
			<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
			</svg>
		</div>
	</div>
	
	<!-- Name -->
	<h2 class="text-lg font-bold text-[var(--color-foreground)] m-0">{name}</h2>
	
	<!-- Quick Info List -->
	<ul class="list-none p-0 m-0 w-full text-sm">
		{info.map((item, index) => (
			<li class="flex items-center gap-2 mb-2 last:mb-0">
				<svg 
					class="w-5 h-5 text-[var(--color-primary)] flex-shrink-0" 
					style="filter: drop-shadow(0 0 4px var(--color-primary))" 
					fill="none" 
					stroke="currentColor" 
					viewBox="0 0 24 24"
				>
					<path 
						stroke-linecap="round" 
						stroke-linejoin="round" 
						stroke-width="2" 
						d={infoIcons[index % infoIcons.length]}
					/>
				</svg>
				<span class="text-[var(--color-foreground)]">{item}</span>
			</li>
		))}
	</ul>
</Card>

<style>
	.avatar-shell {
		position: relative;
		width: 6rem;
		height: 6rem;
		border-radius: 9999px;
		overflow: hidden;
		border: 2px solid var(--color-primary);
		background: color-mix(in srgb, var(--color-primary) 12%, transparent);
		display: grid;
		place-items: center;
	}

	.avatar-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.avatar-fallback {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		color: var(--color-primary);
		opacity: 0.85;
		pointer-events: none;
	}

	.avatar-fallback.hide-fallback {
		opacity: 0;
	}
</style>
