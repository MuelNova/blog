---
/**
 * ProfileCard Component
 * Displays user profile with avatar and quick info
 */

import Card from './Card.astro';

interface Props {
	name: string;
	info?: string[];
}

const { name, info = [] } = Astro.props;

const infoIcons = [
	'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z',
	'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
	'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
];
---

<Card class="flex flex-col items-center gap-3">
	<!-- Avatar -->
	<div class="w-24 h-24 rounded-full bg-[var(--color-primary)]/20 border-2 border-[var(--color-primary)] flex items-center justify-center">
		<svg class="w-12 h-12 text-[var(--color-primary)]" style="filter: drop-shadow(0 0 4px var(--color-primary))" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
		</svg>
	</div>
	
	<!-- Name -->
	<h2 class="text-lg font-bold text-[var(--color-foreground)] m-0">{name}</h2>
	
	<!-- Quick Info List -->
	<ul class="list-none p-0 m-0 w-full text-sm">
		{info.map((item, index) => (
			<li class="flex items-center gap-2 mb-2 last:mb-0">
				<svg 
					class="w-5 h-5 text-[var(--color-primary)] flex-shrink-0" 
					style="filter: drop-shadow(0 0 4px var(--color-primary))" 
					fill="none" 
					stroke="currentColor" 
					viewBox="0 0 24 24"
				>
					<path 
						stroke-linecap="round" 
						stroke-linejoin="round" 
						stroke-width="2" 
						d={infoIcons[index % infoIcons.length]}
					/>
				</svg>
				<span class="text-[var(--color-foreground)]">{item}</span>
			</li>
		))}
	</ul>
</Card>
