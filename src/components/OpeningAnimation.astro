---
/**
 * OpeningAnimation — 「软糖工坊」四幕开场动画（总时长 ≈3.5s）
 *
 * 第一幕·登场：3 个贴纸从三个方向 back.out 弹入，落地 squash & stretch（体积守恒）
 * 第二幕·汇聚充能：贴纸沿向心弧线被吸入屏幕中心的糖果盒，盒盖跳动 + 盒身抖动充能，
 *                 品牌字逐字弹入 + Caveat 手写句扫开
 * 第三幕·间：一拍定格，抖动加到最快后骤停，盒子将爆未爆
 * 第四幕·爆发即揭晓：白闪帧 → 盒盖弹飞、盒身压扁 → 冲击波双环从中心扫过全屏 +
 *                 背景层快速退场（不逗留），同一时刻 reveal 触发 hero 编排——
 *                 首页标题字符从爆炸中心向外飞散归位（"首页是被炸出来的"），
 *                 3 张贴纸从盒中爆出、飞向首页 hero 装饰位落位（intro:sticker-land 无缝交接）
 *
 * 保留契约（下游依赖，勿改）：
 * - localStorage('intro-enabled') 开关（theme-bus 的 isIntroEnabled）
 * - sessionStorage('intro-shown') 只播一次
 * - 播完（及跳过路径）给 body 加 `animation-triggered` class 触发 .landing-section 阶梯入场
 * - 爆发瞬间（act4 半拍后）派发 window 事件 `intro:revealed`（Hero 入场编排监听）
 * - 贴纸落位时派发 window 事件 `intro:sticker-land`，detail: { key: 'candy' | 'donut' | 'flower' }
 * - prefers-reduced-motion：直接跳过
 */
---

<div id="opening-animation" class="fixed inset-0 z-[9999] overflow-hidden select-none" aria-hidden="true">
	<!-- 背景层（与 Hero #hero-bg 渐变逐点对齐，第四幕整体快速淡出，不做 mask） -->
	<div
		id="opening-mask"
		class="absolute inset-0"
		style="background: linear-gradient(180deg, var(--color-background) -12%, var(--color-surface) 56.2%, var(--color-background) 112%);"
	></div>

	<!-- 贴纸 1 · 软糖方块（data-key 对应 hero 装饰的 data-decor） -->
	<svg data-key="candy" viewBox="0 0 64 64" class="intro-sticker absolute left-[18%] top-[26%] h-16 w-16 md:left-[26%] md:top-[30%] md:h-24 md:w-24">
			<rect x="6" y="10" width="52" height="44" rx="16" fill="var(--color-accent)" stroke="var(--color-foreground)" stroke-opacity="0.22" stroke-width="2" />
			<circle cx="26" cy="31" r="3" fill="var(--color-foreground)" />
			<circle cx="40" cy="31" r="3" fill="var(--color-foreground)" />
			<path d="M28 39 Q33 43.5 38 39" stroke="var(--color-foreground)" stroke-width="2" fill="none" stroke-linecap="round" />
			<circle cx="19" cy="37" r="2.4" fill="var(--color-primary)" opacity="0.7" />
			<circle cx="45" cy="37" r="2.4" fill="var(--color-primary)" opacity="0.7" />
		</svg>
		<!-- 贴纸 2 · 甜甜圈 -->
		<svg data-key="donut" viewBox="0 0 64 64" class="intro-sticker absolute right-[16%] top-[30%] h-14 w-14 md:right-[24%] md:top-[36%] md:h-20 md:w-20">
			<circle cx="32" cy="32" r="22" fill="var(--color-primary-light)" stroke="var(--color-foreground)" stroke-opacity="0.22" stroke-width="2" />
			<circle cx="32" cy="32" r="9" fill="var(--color-background)" stroke="var(--color-foreground)" stroke-opacity="0.22" stroke-width="2" />
			<circle cx="24" cy="22" r="2" fill="var(--color-accent)" />
			<circle cx="42" cy="26" r="2" fill="var(--color-accent-2)" />
			<circle cx="30" cy="44" r="2" fill="var(--color-accent)" />
		</svg>
		<!-- 贴纸 3 · 小花 -->
		<svg data-key="flower" viewBox="0 0 64 64" class="intro-sticker absolute bottom-[24%] left-[30%] h-12 w-12 md:bottom-[28%] md:left-[40%] md:h-16 md:w-16">
			<g fill="var(--color-accent-2)" stroke="var(--color-foreground)" stroke-opacity="0.2" stroke-width="2">
				<ellipse cx="32" cy="16" rx="8" ry="11" />
				<ellipse cx="32" cy="48" rx="8" ry="11" />
				<ellipse cx="16" cy="32" rx="11" ry="8" />
				<ellipse cx="48" cy="32" rx="11" ry="8" />
			</g>
			<circle cx="32" cy="32" r="7" fill="var(--color-primary-lightest)" stroke="var(--color-foreground)" stroke-opacity="0.2" stroke-width="2" />
		</svg>

		<!-- 中心糖果盒（第二幕充能容器，第四幕盒盖弹飞、盒身压扁、贴纸爆出） -->
		<div class="intro-box absolute inset-0 m-auto h-24 w-24 md:h-32 md:w-32">
			<svg viewBox="0 0 64 64" class="h-full w-full overflow-visible">
				<!-- 盒身：圆角盒 + 竖缎带 + 小圆点装饰 -->
				<g class="intro-box-body">
					<rect x="10" y="26" width="44" height="28" rx="9" fill="var(--color-primary-lightest)" stroke="var(--color-foreground)" stroke-opacity="0.22" stroke-width="2" />
					<rect x="28" y="26" width="8" height="28" fill="var(--color-primary)" opacity="0.55" />
					<circle cx="18" cy="40" r="2.2" fill="var(--color-accent-2)" />
					<circle cx="46" cy="40" r="2.2" fill="var(--color-accent)" />
				</g>
				<!-- 盒盖：盖面 + 横缎带 + 蝴蝶结（爆发时整体弹飞） -->
				<g class="intro-box-lid">
					<rect x="6" y="17" width="52" height="11" rx="5.5" fill="var(--color-accent)" stroke="var(--color-foreground)" stroke-opacity="0.22" stroke-width="2" />
					<rect x="28" y="17" width="8" height="11" fill="var(--color-primary)" opacity="0.55" />
					<ellipse cx="24" cy="13" rx="7" ry="4.5" transform="rotate(-18 24 13)" fill="var(--color-primary)" stroke="var(--color-foreground)" stroke-opacity="0.22" stroke-width="2" />
					<ellipse cx="40" cy="13" rx="7" ry="4.5" transform="rotate(18 40 13)" fill="var(--color-primary)" stroke="var(--color-foreground)" stroke-opacity="0.22" stroke-width="2" />
					<circle cx="32" cy="14" r="3.2" fill="var(--color-primary)" stroke="var(--color-foreground)" stroke-opacity="0.22" stroke-width="2" />
				</g>
			</svg>
		</div>

		<!-- 品牌字 + 手写小句（居中叠在盒子上方，爆发时溶解） -->
		<div class="intro-center absolute inset-0 z-10 flex flex-col items-center justify-center gap-2 md:gap-3">
			<div class="intro-brand font-display text-[clamp(1.6rem,5vw,2.8rem)] font-extrabold tracking-[-0.02em] text-foreground-secondary">
				Muir's Cream
			</div>
			<div class="intro-tagline text-[clamp(1.1rem,3vw,1.6rem)] text-foreground-secondary" style="font-family: var(--font-hand);">
				have a sweet day!
			</div>
		</div>

		<!-- 第四幕：冲击波双环（爆炸的可见载体，从中心扫过全屏） -->
		<div class="intro-ring pointer-events-none absolute inset-0 m-auto h-28 w-28 rounded-full"></div>
		<div class="intro-ring-2 pointer-events-none absolute inset-0 m-auto h-28 w-28 rounded-full"></div>

		<!-- 第四幕：粒子爆发画布（只在爆发瞬间激活，播完即移除。
		     注意：canvas 是替换元素，inset-0 不会拉伸它，必须显式 h-full w-full，
		     否则高 dpr 下画布按属性尺寸(2x视口)渲染，中心爆发会跑到右下角） -->
		<canvas class="intro-burst pointer-events-none absolute inset-0 z-20 h-full w-full"></canvas>
		<!-- 第四幕：奶油色白闪帧 -->
		<div class="intro-flash pointer-events-none absolute inset-0 z-30" style="background: var(--color-background); opacity: 0;"></div>
	</div>

<script is:inline>
	// 早期检查，避免内容闪烁（inline：模块脚本之前执行，直接读 localStorage）
	try {
		const introEnabled = localStorage.getItem('intro-enabled') !== 'false';
		const hasShown = sessionStorage.getItem('intro-shown');
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		if (introEnabled && !hasShown && !reduceMotion) {
			// 首次访问且启用：完整动画
			document.body.classList.add('is-animating');
		} else {
			// 关闭 / 已播过 / reduced-motion：立即跳过，直接触发 landIn
			const container = document.getElementById('opening-animation');
			if (container) container.style.display = 'none';
			document.body.classList.add('animation-triggered');
		}
	} catch (e) {}
</script>

<script>
	import gsap from 'gsap';
	import { isIntroEnabled } from '../lib/theme-bus';

	function startAnimation() {
		const container = document.getElementById('opening-animation');
		const mask = document.getElementById('opening-mask');

		const hasShown = sessionStorage.getItem('intro-shown') === 'true';
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		// 跳过路径：inline 脚本已处理 class，这里只清理 DOM
		if (!isIntroEnabled() || hasShown || reduceMotion) {
			if (container) container.remove();
			document.body.classList.remove('is-animating');
			document.body.classList.add('animation-triggered');
			return;
		}
		if (!container || !mask) return;

		// 标记已播（每次会话一次）
		try {
			sessionStorage.setItem('intro-shown', 'true');
		} catch (e) {}
		document.body.classList.add('is-animating');

		const stickers = Array.from(container.querySelectorAll<SVGElement>('.intro-sticker'));
		const brand = container.querySelector<HTMLElement>('.intro-brand');
		const tagline = container.querySelector('.intro-tagline');
		const box = container.querySelector('.intro-box');
		const boxLid = container.querySelector('.intro-box-lid');
		const boxBody = container.querySelector('.intro-box-body');
		const rings = Array.from(container.querySelectorAll<HTMLElement>('.intro-ring, .intro-ring-2'));
		const flash = container.querySelector('.intro-flash');
		if (!brand || !tagline || !box || !boxLid || !boxBody || !flash) return;

		// 半拍网格：timeline 的 position 只允许 label + BEAT 的倍数/半数倍
		const BEAT = 0.215;

		// 幂等：正常路径（act4 白闪帧后）与 failsafe 都可能触发
		let revealed = false;
		const reveal = () => {
			if (revealed) return;
			revealed = true;
			document.body.classList.add('animation-triggered');
			window.dispatchEvent(new Event('intro:revealed'));
		};

		// 品牌字拆成单字 span，准备逐字弹入
		const brandText = (brand.textContent || '').trim();
		brand.textContent = '';
		const chars: HTMLSpanElement[] = [];
		for (const ch of brandText) {
			if (ch === ' ') {
				brand.appendChild(document.createTextNode('\u00A0'));
				continue;
			}
			const span = document.createElement('span');
			span.className = 'intro-ch';
			span.textContent = ch;
			brand.appendChild(span);
			chars.push(span);
		}

		// 记录每个贴纸中心到屏幕中心的向量（第二幕向心汇聚用），
		// 以及贴纸的布局尺寸（第四幕计算落位缩放比用），
		// 必须在任何 transform 之前量取
		const vw = window.innerWidth;
		const vh = window.innerHeight;
		const cx = vw / 2;
		const cy = vh / 2;
		const stickerRects = stickers.map((s) => s.getBoundingClientRect());
		const toCenter = stickerRects.map((r) => ({
			x: cx - (r.left + r.width / 2),
			y: cy - (r.top + r.height / 2),
		}));

		// 首页 hero 装饰位（与 src/components/hero/Hero.astro 的 #hero-decor 同款图形）：
		// 优先直接测量 hero 装饰 span 的实际布局位置——此时装饰 span 尚无 transform
		// （鼠标视差未动/为 0），内部 svg 的 scale 不影响 span 自身盒模型，
		// 百分比定位 / 100svh 高度 / 断点尺寸全部以真实渲染为准，消灭硬算偏差；
		// 测量失败（元素缺失或 display:none，如移动端 flower 装饰 hidden）回退到硬算表。
		const isMd = vw >= 768;
		const FALLBACK_TARGETS = [
			{
				key: 'candy', // left-[7%] top-[20%]，h-14 w-14 md:h-20 md:w-20
				size: isMd ? 80 : 56,
				cx: vw * 0.07 + (isMd ? 80 : 56) / 2,
				cy: vh * 0.2 + (isMd ? 80 : 56) / 2,
			},
			{
				key: 'donut', // right-[9%] top-[24%]，h-12 w-12 md:h-16 md:w-16
				size: isMd ? 64 : 48,
				cx: vw * (1 - 0.09) - (isMd ? 64 : 48) / 2,
				cy: vh * 0.24 + (isMd ? 64 : 48) / 2,
			},
			{
				key: 'flower', // bottom-[22%] left-[13%]，h-12 w-12 md:h-16 md:w-16
				size: isMd ? 64 : 48,
				cx: vw * 0.13 + (isMd ? 64 : 48) / 2,
				cy: vh * (1 - 0.22) - (isMd ? 64 : 48) / 2,
			},
		];
		const LAND_TARGETS = FALLBACK_TARGETS.map((fb) => {
			const el = document.querySelector<HTMLElement>(`[data-decor="${fb.key}"]`);
			if (!el) return fb;
			const r = el.getBoundingClientRect();
			if (r.width < 1 || r.height < 1) return fb; // display:none（如移动端 flower）
			return { key: fb.key, size: r.width, cx: r.left + r.width / 2, cy: r.top + r.height / 2 };
		});
		// 每张贴纸的飞行计划：起点（屏幕中心，即第二幕吸入的终点）→ 上抛弧顶 → 落位点
		const flights = stickers.map((_, i) => {
			const start = { x: toCenter[i].x, y: toCenter[i].y };
			const end = {
				x: toCenter[i].x + (LAND_TARGETS[i].cx - cx),
				y: toCenter[i].y + (LAND_TARGETS[i].cy - cy),
			};
			const mid = {
				x: (start.x + end.x) / 2,
				y: (start.y + end.y) / 2 - (36 + i * 14), // 轻微上抛即可，接近直线弹道
			};
			const scaleTo = LAND_TARGETS[i].size / stickerRects[i].width;
			return { start, mid, end, scaleTo };
		});

		// ---- 初始状态 ----
		// 三个贴纸分别从 左 / 右 / 下 三个方向屏外待命
		const enterFrom = [
			{ x: -vw * 0.55, y: -vh * 0.08, rotation: -32 },
			{ x: vw * 0.55, y: -vh * 0.04, rotation: 26 },
			{ x: -vw * 0.1, y: vh * 0.6, rotation: -20 },
		];
		stickers.forEach((s, i) => {
			gsap.set(s, { x: enterFrom[i].x, y: enterFrom[i].y, rotation: enterFrom[i].rotation, opacity: 0 });
		});
		gsap.set(box, { scale: 0 });
		gsap.set(chars, { opacity: 0, y: 16, rotation: () => gsap.utils.random(-6, 6) });
		gsap.set(tagline, { clipPath: 'inset(0 100% 0 0)' });

		// ---- 第二/三幕 · 糖果盒充能（盒身抖动 + 盒盖跳动，独立循环 tween，时间线只负责启停） ----
		let shakeTweens: gsap.core.Tween[] = [];
		const startShake = (intensity: number) => {
			shakeTweens.forEach((t) => t.kill());
			shakeTweens = [
				// 盒身快速抖动：intensity 越大角度越大、频率越高
				gsap.to(box, {
					rotation: 1.4 * intensity,
					duration: (BEAT * 0.5) / intensity,
					yoyo: true,
					repeat: -1,
					ease: 'sine.inOut',
				}),
				// 盒盖被里面的糖果顶得微微跳起
				gsap.to(boxLid, {
					y: -1.6 * intensity,
					duration: (BEAT * 0.5) / intensity,
					yoyo: true,
					repeat: -1,
					ease: 'sine.inOut',
				}),
			];
		};
		const stopShake = () => {
			shakeTweens.forEach((t) => t.kill());
			shakeTweens = [];
			// 骤停：抖到最快直接定住，将爆未爆
			gsap.set(box, { rotation: 0 });
			gsap.set(boxLid, { y: 0 });
		};

		// ---- 第四幕 · 冲击波环 ----
		// 爆炸的可见载体：奶油色圆环从中心扩张扫过全屏（替代原花瓣 mask——
		// mask 两边渐变一致导致揭开动作完全不可见，反而像空屏等待）
		const corner = Math.hypot(vw / 2, vh / 2); // 中心到屏幕角落的距离
		const ringScale = ((corner * 2.4) / 112).toFixed(1); // h-28=112px，放大到覆盖角落

		// ---- 第四幕 · Canvas 粒子爆发 ----
		// 颜色从 getComputedStyle 读主题变量，亮暗主题自动适配
		let burstCleanup: (() => void) | null = null;
		const readThemeColors = () => {
			const css = getComputedStyle(document.body);
			const fallbacks = ['#FFB583', '#FFD3E0', '#BBE9F2'];
			return ['--color-primary', '--color-accent', '--color-accent-2'].map(
				(name, i) => css.getPropertyValue(name).trim() || fallbacks[i]
			);
		};
		const drawStar = (ctx: CanvasRenderingContext2D, x: number, y: number, size: number, rot: number) => {
			ctx.save();
			ctx.translate(x, y);
			ctx.rotate(rot);
			ctx.beginPath();
			for (let i = 0; i < 5; i++) {
				const a = (i * 4 * Math.PI) / 5 - Math.PI / 2;
				const px = Math.cos(a) * size;
				const py = Math.sin(a) * size;
				if (i === 0) ctx.moveTo(px, py);
				else ctx.lineTo(px, py);
			}
			ctx.closePath();
			ctx.fill();
			ctx.restore();
		};
		const startBurst = () => {
			const canvas = container.querySelector<HTMLCanvasElement>('.intro-burst');
			if (!canvas) return;
			const ctx = canvas.getContext('2d');
			if (!ctx) return;
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			canvas.width = vw * dpr;
			canvas.height = vh * dpr;
			ctx.scale(dpr, dpr);
			const colors = readThemeColors();
			type BurstParticle = {
				kind: string;
				x: number;
				y: number;
				vx: number;
				vy: number;
				rot: number;
				vr: number;
				size: number;
				len: number;
				color: string;
				life: number;
				t: number;
			};
			const parts: BurstParticle[] = [];
			// 纸屑：星星 + 圆点，初速大、阻尼大、寿命短促但肉眼可辨
			// （减量到 ~30 个，主角是飞出去的贴纸，粒子不抢戏）
			for (let i = 0; i < 30; i++) {
				const a = Math.random() * Math.PI * 2;
				const sp = 420 + Math.random() * 680;
				parts.push({
					kind: Math.random() < 0.5 ? 'star' : 'dot',
					x: cx, y: cy,
					vx: Math.cos(a) * sp,
					vy: Math.sin(a) * sp - 120,
					rot: Math.random() * Math.PI * 2,
					vr: (Math.random() - 0.5) * 14,
					size: 4 + Math.random() * 6,
					len: 0,
					color: colors[i % colors.length],
					life: 0.28 + Math.random() * 0.18,
					t: 0,
				});
			}
			// 短速度线：沿径向甩出，一闪即敛
			for (let i = 0; i < 8; i++) {
				const a = (i / 8) * Math.PI * 2 + Math.random() * 0.3;
				const sp = 900 + Math.random() * 500;
				parts.push({
					kind: 'line',
					x: cx, y: cy,
					vx: Math.cos(a) * sp,
					vy: Math.sin(a) * sp,
					rot: 0,
					vr: 0,
					size: 0,
					len: 26 + Math.random() * 22,
					color: colors[i % colors.length],
					life: 0.15 + Math.random() * 0.1,
					t: 0,
				});
			}
			let last = performance.now();
			let rafId = 0;
			let dead = false;
			burstCleanup = () => {
				dead = true;
				cancelAnimationFrame(rafId);
				if (canvas.isConnected) canvas.remove();
			};
			const step = (now: number) => {
				if (dead) return;
				const dt = Math.min((now - last) / 1000, 0.05);
				last = now;
				ctx.clearRect(0, 0, vw, vh);
				let alive = false;
				for (const p of parts) {
					p.t += dt;
					if (p.t >= p.life) continue;
					alive = true;
					const k = Math.exp(-5.5 * dt); // 强阻尼：速度指数衰减
					p.vx *= k;
					p.vy *= k;
					if (p.kind !== 'line') p.vy += 300 * dt; // 纸屑轻微下落
					p.x += p.vx * dt;
					p.y += p.vy * dt;
					const alpha = 1 - p.t / p.life;
					ctx.globalAlpha = alpha;
					ctx.fillStyle = p.color;
					ctx.strokeStyle = p.color;
					if (p.kind === 'dot') {
						ctx.beginPath();
						ctx.arc(p.x, p.y, p.size * alpha + 0.5, 0, 7);
						ctx.fill();
					} else if (p.kind === 'star') {
						p.rot += p.vr * dt;
						drawStar(ctx, p.x, p.y, p.size, p.rot);
					} else {
						ctx.lineWidth = 2.5;
						ctx.lineCap = 'round';
						const m = Math.hypot(p.vx, p.vy) || 1;
						ctx.beginPath();
						ctx.moveTo(p.x, p.y);
						ctx.lineTo(p.x - (p.vx / m) * p.len, p.y - (p.vy / m) * p.len);
						ctx.stroke();
					}
				}
				ctx.globalAlpha = 1;
				if (alive) {
					rafId = requestAnimationFrame(step);
				} else if (canvas.isConnected) {
					canvas.remove(); // 全部粒子寿终，停 rAF 并移除画布
				}
			};
			rafId = requestAnimationFrame(step);
		};

		const cleanup = () => {
			window.clearTimeout(failsafe);
			if (burstCleanup) burstCleanup();
			stopShake();
			gsap.killTweensOf([container, mask, flash, box, boxLid, boxBody, brand, tagline, chars, stickers, rings]);
			document.body.classList.remove('is-animating');
			if (container.isConnected) container.remove();
		};

		// 超时保险：任何异常导致时间线没跑完，5.5s 后强制优雅退场
		const failsafe = window.setTimeout(() => {
			gsap.to(container, { opacity: 0, duration: 0.3, onComplete: cleanup });
			reveal();
		}, 5500);

		const tl = gsap.timeline({ onComplete: cleanup });
		tl.addLabel('act1', 0)
			.addLabel('act2', BEAT * 3)
			.addLabel('act3', BEAT * 8)
			.addLabel('act4', BEAT * 9);

		// 第一幕 · 登场（0 ~）：三方向飞入 + back.out 弹落
		tl.to(
			stickers,
			{ x: 0, y: 0, rotation: 0, opacity: 1, duration: BEAT * 2, ease: 'back.out(2.4)', stagger: 0.2 },
			'act1'
		)
			// 落地 squash & stretch：压扁（scaleX 1.25 / scaleY 0.75，体积守恒，origin 贴地）
			.to(
				stickers,
				{ scaleX: 1.25, scaleY: 0.75, duration: BEAT * 0.5, ease: 'power2.out', stagger: 0.2 },
				`act1+=${BEAT * 2}`
			)
			// 回弹归正
			.to(
				stickers,
				{ scaleX: 1, scaleY: 1, duration: BEAT, ease: 'elastic.out(1, 0.45)', stagger: 0.2 },
				`act1+=${BEAT * 2.5}`
			);

		// 第二幕 · 汇聚充能（0.645 ~）
		// 压扁回弹可能还在振荡，先强制归位并把 origin 换回中心，避免与吸入动画抢属性
		tl.set(stickers, { scaleX: 1, scaleY: 1, transformOrigin: '50% 50%' }, 'act2')
			// 向心弧线吸入：先绕弧过半程（带切向偏移），再加速坠入盒中
			.to(
				stickers,
				{
					keyframes: [
						{
							x: (i) => toCenter[i].x * 0.5 - toCenter[i].y * 0.22,
							y: (i) => toCenter[i].y * 0.5 + toCenter[i].x * 0.22,
							rotation: '+=100',
							scale: 0.55,
							duration: BEAT * 1.5,
							ease: 'power2.in',
						},
						{
							x: (i) => toCenter[i].x,
							y: (i) => toCenter[i].y,
							rotation: '+=100',
							scale: 0.1,
							opacity: 0,
							duration: BEAT * 1.5,
							ease: 'power2.in',
						},
					],
					stagger: 0.06,
					overwrite: 'auto',
				},
				'act2'
			)
			// 糖果盒登场
			.to(box, { scale: 1, duration: BEAT * 2, ease: 'back.out(1.7)' }, 'act2')
			// 盒身轻微呼吸放大（充能感），第四幕压扁时 overwrite 掉
			.to(box, { scale: 1.05, duration: BEAT * 5, ease: 'sine.inOut' }, `act2+=${BEAT}`)
			// 开始充能：盒身抖动 + 盒盖跳动（低档）
			.call(() => startShake(1), undefined, `act2+=${BEAT}`)
			// 品牌字逐字弹入（每字带 ±6° 随机旋转归正）
			.to(
				chars,
				{ opacity: 1, y: 0, rotation: 0, duration: BEAT * 1.5, ease: 'back.out(2.5)', stagger: 0.05 },
				`act2+=${BEAT * 0.5}`
			)
			// Caveat 手写句 clip-path 从左到右扫开
			.to(tagline, { clipPath: 'inset(0 0% 0 0)', duration: BEAT * 1.5, ease: 'power2.out' }, `act2+=${BEAT * 2}`);

		// 第三幕 · 间（1.72 ~ 1.935）：一拍定格，抖动加到最快，末帧骤停（stopShake 在 act4 第一帧执行）
		tl.call(() => startShake(2.2), undefined, 'act3');

		// 第四幕 · 爆发即揭晓（1.935 ~）：爆炸与首页揭晓是同一帧的里外两面——
		// 白闪帧 → 盒盖弹飞 + 冲击波环扫过全屏 + 背景层快速退场（不逗留），
		// 同一时刻 reveal 触发 hero 编排：标题字符从爆炸中心向外飞散归位，
		// 贴纸沿直线弹道飞向首页装饰位（intro:sticker-land 无缝交接）
		tl
			// 抖动骤停 + 120ms 奶油色白闪帧
			.call(stopShake, undefined, 'act4')
			.to(flash, { keyframes: [{ opacity: 1, duration: 0.06 }, { opacity: 0, duration: 0.06 }], ease: 'none' }, 'act4')
			// 盒盖弹飞：向上旋转飞出并淡出；盒身压扁后淡出
			.to(boxLid, { y: -vh * 0.45, rotation: -140, opacity: 0, duration: BEAT * 1.5, ease: 'power2.out' }, 'act4')
			.to(
				boxBody,
				{ scaleX: 1.25, scaleY: 0.6, opacity: 0, duration: BEAT, ease: 'power2.in', transformOrigin: '50% 100%' },
				'act4'
			)
			.to(box, { scale: 1, rotation: 0, duration: BEAT * 0.5, ease: 'power1.out', overwrite: 'auto' }, 'act4')
			// 点燃 Canvas 纸屑爆发
			.add(startBurst, 'act4')
			// 冲击波双环：主环蜜桃、副环粉，从中心扩张扫过全屏
			.fromTo(
				rings[0],
				{ scale: 0, opacity: 0.9 },
				{ scale: Number(ringScale), opacity: 0, duration: BEAT * 3.5, ease: 'power2.out' },
				'act4'
			)
			.fromTo(
				rings[1],
				{ scale: 0, opacity: 0.7 },
				{ scale: Number(ringScale) * 0.82, opacity: 0, duration: BEAT * 3, ease: 'power2.out' },
				`act4+=${BEAT * 0.5}`
			)
			// 品牌字 / 手写句在爆炸中溶解
			.to([brand, tagline], { opacity: 0, duration: BEAT, ease: 'power1.out' }, 'act4')
			// 背景层快速退场（半拍后，不逗留）：首页从爆炸中心"炸出来"
			.to(mask, { opacity: 0, duration: BEAT * 2, ease: 'power1.in' }, `act4+=${BEAT * 0.5}`)
			// 同一时刻触发 hero 编排：标题字符从爆炸中心向外飞散归位
			.call(reveal, undefined, `act4+=${BEAT * 0.5}`)
			// 三张贴纸从盒中爆出（中心 scale 0→1 快速弹出）
			.set(stickers, { opacity: 1, scale: 0, rotation: 0 }, `act4+=${BEAT * 0.5}`)
			.to(stickers, { scale: 1, duration: BEAT * 0.75, ease: 'back.out(3)', stagger: 0.06 }, `act4+=${BEAT * 0.5}`);

		// 贴纸沿弧线飞向首页 hero 装饰位落位（每张贴纸独立 tween 以便各自派发落位事件；
		// stagger 用 delay 表达，position 保持 BEAT 网格）
		stickers.forEach((s, i) => {
			const f = flights[i];
			const key = LAND_TARGETS[i].key;
			tl.to(
				s,
				{
					keyframes: [
						{
							x: f.mid.x,
							y: f.mid.y,
							rotation: '+=180',
							scale: (1 + f.scaleTo) / 2,
							duration: BEAT * 1.5,
							ease: 'power2.out',
						},
						{
							x: f.end.x,
							y: f.end.y,
							rotation: '+=180', // 全程 360°：落位朝向与 hero 装饰（0°）一致
							scale: f.scaleTo,
							duration: BEAT * 1.5,
							ease: 'power2.in',
						},
					],
					delay: i * 0.08,
					onComplete: () => {
						// 落位钉死：当帧实测 hero 装饰位置，把 sticker 视觉中心 snap 到完全重合——
						// 无论测量时机/视差/布局造成多少偏差，交接瞬间两边像素级对齐，
						// 杜绝"贴纸落位 → 装饰在另一个位置弹出"的二次移动感。
						const decorEl = document.querySelector<HTMLElement>(`[data-decor="${key}"]`);
						if (decorEl) {
							const dr = decorEl.getBoundingClientRect();
							const sr = s.getBoundingClientRect();
							const dx = dr.left + dr.width / 2 - (sr.left + sr.width / 2);
							const dy = dr.top + dr.height / 2 - (sr.top + sr.height / 2);
							if (Math.abs(dx) > 0.5 || Math.abs(dy) > 0.5) {
								gsap.set(s, { x: `+=${dx}`, y: `+=${dy}` });
							}
						}
						// 同帧通知 hero 装饰以最终形态接班，自己 0.2s 淡出——
						// 与 hero 装饰的 0.2s 沉降淡入交叠，视觉上贴纸"变成"了首页装饰
						window.dispatchEvent(new CustomEvent('intro:sticker-land', { detail: { key } }));
						gsap.to(s, { opacity: 0, duration: 0.2, ease: 'power1.out' });
					},
				},
				`act4+=${BEAT}`
			);
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', startAnimation);
	} else {
		startAnimation();
	}
</script>

<style>
	#opening-mask {
		will-change: opacity;
	}

	/* 冲击波环：爆炸的可见载体 */
	.intro-ring,
	.intro-ring-2 {
		border: 3px solid var(--color-primary);
		opacity: 0;
		will-change: transform, opacity;
	}

	.intro-ring-2 {
		border-color: var(--color-accent);
	}

	/* 贴纸 squash & stretch 的支点贴地 */
	.intro-sticker {
		transform-origin: 50% 100%;
		will-change: transform, opacity;
	}

	/* 糖果盒：充能抖动 / 呼吸 / 爆发的载体 */
	.intro-box {
		will-change: transform;
	}

	.intro-brand .intro-ch {
		display: inline-block;
		will-change: transform, opacity;
	}

	.intro-tagline {
		will-change: clip-path;
	}
</style>

<style is:global>
	/* 开场播放期间锁定滚动：防止用户滚动导致 hero 装饰位置漂移、贴纸落位失准 */
	body.is-animating {
		overflow: hidden;
	}

	/* Global Landing Animation Styles */
	/* Force initial hidden state when animation is active BUT not yet triggered */
	body.is-animating:not(.animation-triggered) .landing-section {
		opacity: 0 !important;
		transform: scale(0.9) translateY(50px);
		filter: blur(10px);
		pointer-events: none;
		will-change: transform, opacity, filter;
	}

	/* Trigger animation */
	body.animation-triggered .landing-section {
		animation: landIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) both;
		pointer-events: auto;
	}

	body.animation-triggered .landing-section.delay-0 { animation-delay: 0ms; }
	body.animation-triggered .landing-section.delay-100 { animation-delay: 100ms; }
	body.animation-triggered .landing-section.delay-200 { animation-delay: 200ms; }
	body.animation-triggered .landing-section.delay-300 { animation-delay: 300ms; }
	body.animation-triggered .landing-section.delay-400 { animation-delay: 400ms; }
	body.animation-triggered .landing-section.delay-500 { animation-delay: 500ms; }

	@keyframes landIn {
		0% {
			opacity: 0;
			transform: scale(0.9) translateY(50px);
			filter: blur(10px);
		}
		100% {
			opacity: 1;
			transform: scale(1) translateY(0);
			filter: blur(0);
		}
	}
</style>
