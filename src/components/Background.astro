---
/**
 * Background Component
 * Renders animated glowing text background effect
 * Adapted from Spectre theme
 */
---

<canvas id="bg-canvas"></canvas>
<canvas id="overlay-canvas"></canvas>

<script src="../scripts/page-background.ts"></script>

<style>
  #bg-canvas, #overlay-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -2;
    transition: all 0.15s ease;
    opacity: 0;
    font-family: 'Geist Mono', 'Courier New', Courier, monospace;
    user-select: none;
    pointer-events: none;
  }

  #overlay-canvas {
    opacity: 1;
    z-index: -1 !important;
  }
</style>
