---
/**
 * Background Component
 * Low-density floating candy particles on a single fixed canvas.
 * Colors follow the active cream / cream-dark theme via CSS variables.
 */
---

<canvas id="bg-canvas" aria-hidden="true"></canvas>

<script src="../scripts/page-background.ts"></script>

<style>
  #bg-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    user-select: none;
    pointer-events: none;
  }
</style>
