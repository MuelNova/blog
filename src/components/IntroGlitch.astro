<div class="intro-overlay" data-intro-overlay>
	<div class="intro-noise" aria-hidden="true"></div>
	<div class="intro-scan" aria-hidden="true"></div>
	<div class="intro-label">Recalibrating…</div>
</div>

<script>
	(() => {
		const INTRO_KEY = 'intro-played-session-v1';
		const overlay = document.querySelector('[data-intro-overlay]');
		if (!overlay) return;

		const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const introEnabled = window.__introEnabled !== false && localStorage.getItem('intro-enabled') !== 'false';
		const alreadyPlayed = sessionStorage.getItem(INTRO_KEY) === 'true';
		const deferredTheme = window.__deferredTheme;
		const currentTheme = document.documentElement.getAttribute('data-theme');
		const storedTheme = localStorage.getItem('theme');
		const targetTheme = deferredTheme || storedTheme || currentTheme || 'spectre';

		const finish = () => {
			document.documentElement.setAttribute('data-theme', targetTheme);
			overlay.classList.add('intro-overlay--fade');
			setTimeout(() => overlay.remove(), 320);
			sessionStorage.setItem(INTRO_KEY, 'true');
		};

		if (!introEnabled) {
			finish();
			return;
		}

		if (prefersReduced) {
			finish();
			return;
		}

		// If already seen this session, keep the quick glitch without plain-intro pause
		if (alreadyPlayed) {
			overlay.classList.add('intro-overlay--active');
			setTimeout(finish, 420);
			return;
		}

		// Allow a short glimpse of the plain-intro theme before the glitch overlay kicks in
		const showPlainFor = 1280;
		setTimeout(() => {
			overlay.classList.add('intro-overlay--active');
		}, showPlainFor);

		setTimeout(() => {
			document.documentElement.setAttribute('data-theme', targetTheme);
		}, showPlainFor + 920);

		setTimeout(finish, showPlainFor + 1250);
	})();
</script>

<style>
	.intro-overlay {
		position: fixed;
		inset: 0;
		z-index: 9999;
		display: grid;
		place-items: center;
		background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.06), transparent 45%),
			radial-gradient(circle at 70% 60%, rgba(37, 99, 235, 0.12), transparent 40%),
			#0b1220;
		color: #e5e9f2;
		font-family: "Geist", system-ui, -apple-system, sans-serif;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		opacity: 0;
		pointer-events: all;
		transition: opacity 280ms ease-out;
	}

	.intro-overlay--active {
		opacity: 1;
	}

	.intro-overlay--fade {
		opacity: 0;
	}

	.intro-label {
		position: relative;
		padding: 0.8rem 1.4rem;
		background: rgba(11, 18, 32, 0.65);
		border: 1px solid rgba(149, 163, 184, 0.45);
		border-radius: 14px;
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.32), inset 0 0 0 1px rgba(255, 255, 255, 0.05);
		backdrop-filter: blur(8px);
		font-weight: 700;
		text-shadow: 0 0 12px rgba(37, 99, 235, 0.55);
		animation: label-flicker 850ms linear infinite;
	}

	.intro-noise {
		position: absolute;
		inset: -20%;
		background-image:
			repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.05) 0, rgba(255, 255, 255, 0.05) 1px, transparent 1px, transparent 3px),
			repeating-linear-gradient(90deg, rgba(37, 99, 235, 0.08) 0, rgba(37, 99, 235, 0.08) 1px, transparent 1px, transparent 4px);
		opacity: 0.4;
		mix-blend-mode: screen;
		animation: noise-shift 420ms steps(3) infinite;
	}

	.intro-scan {
		position: absolute;
		inset: 0;
		background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 0%, rgba(255, 255, 255, 0.08) 50%, rgba(0, 0, 0, 0) 100%);
		mix-blend-mode: soft-light;
		animation: scan-move 1.1s ease-in-out infinite;
	}

	@keyframes noise-shift {
		0% { transform: translate3d(0, 0, 0); }
		50% { transform: translate3d(-6px, 4px, 0); }
		100% { transform: translate3d(5px, -6px, 0); }
	}

	@keyframes scan-move {
		0% { transform: translateY(-100%); opacity: 0; }
		10% { opacity: 0.6; }
		50% { transform: translateY(20%); opacity: 0.25; }
		100% { transform: translateY(120%); opacity: 0; }
	}

	@keyframes label-flicker {
		0%, 100% { opacity: 1; filter: drop-shadow(0 0 8px rgba(37, 99, 235, 0.6)); }
		50% { opacity: 0.85; filter: drop-shadow(0 0 14px rgba(37, 99, 235, 0.8)); }
	}
</style>
