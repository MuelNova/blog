---
/**
 * CardHeader Component
 * Header with icon and title for cards
 */

interface Props {
	title: string;
	icon?: 'user' | 'rss' | 'folder' | 'briefcase';
}

const { title, icon } = Astro.props;

const icons = {
	user: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z',
	rss: 'M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z',
	folder: 'M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z',
	briefcase: 'M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
};
---

<div class="flex items-center gap-3 mb-4">
	{icon && (
		<svg 
			class="w-5 h-5 text-accent flex-shrink-0" 
			style="filter: drop-shadow(0 0 4px var(--color-accent))" 
			fill="none" 
			stroke="currentColor" 
			viewBox="0 0 24 24"
		>
			<path 
				stroke-linecap="round" 
				stroke-linejoin="round" 
				stroke-width="2" 
				d={icons[icon]}
			/>
		</svg>
	)}
	<h2 class="text-lg font-semibold text-accent m-0">{title}</h2>
</div>
