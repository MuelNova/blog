---
/**
 * SocialsCard Component
 * Displays social media links
 */

import Card from './Card.astro';
import CardHeader from './CardHeader.astro';
import type { Social } from '../types';
import { Icon } from 'astro-icon/components';
import { defaultLang, type Lang, useTranslations } from '../i18n/config';

interface Props {
	socials: Social[];
	lang?: Lang;
}

const { socials, lang: langProp } = Astro.props as Props;
const lang = langProp ?? defaultLang;
const t = useTranslations(lang);
---

<Card>
	<CardHeader title={t('home.socials.title')} />

	<ul class="list-none p-0 m-0 flex flex-col gap-1">
		{socials.map((social) => (
			<li>
				<a
					href={social.url}
					class="social-row"
					target="_blank"
					rel="noopener noreferrer"
				>
					<Icon
						name={social.icon}
						class="w-5 h-5 text-accent flex-shrink-0 iconify"
					/>
					<span>{social.name}</span>
				</a>
			</li>
		))}
	</ul>
</Card>

<style>
	.social-row {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		padding: 0.375rem 0.625rem;
		margin: 0 -0.625rem;
		border-radius: 100px;
		font-size: 0.875rem;
		color: var(--color-foreground);
		text-decoration: none;
		transition: background-color 200ms ease, transform 300ms var(--ease-pop);
	}

	@media (hover: hover) {
		.social-row:hover,
		.social-row:focus-visible {
			background: color-mix(in srgb, var(--color-accent) 18%, transparent);
			transform: translateX(0.25rem);
		}
	}
</style>
