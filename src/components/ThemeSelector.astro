---
/**
 * Theme Selector Component (Muir's Cream)
 *
 * A small sun/moon popover with three options:
 * light (cream) / dark (cream-dark) / follow system.
 * Keeps the intro-animation toggle (localStorage 'intro-enabled').
 * Keyboard shortcut: Ctrl+K / ⌘+K.
 */

import { Icon } from 'astro-icon/components';
import { defaultLang, useTranslations } from '../i18n/config';

const { lang = defaultLang } = Astro.props as { lang?: import('../i18n/config').Lang };
const t = useTranslations(lang);
---

<div class="inline-flex theme-selector-wrapper">
	<!-- Trigger Button -->
	<button
		class="flex items-center justify-center px-[0.5rem] py-[0.25rem] rounded-md text-foreground hover:text-accent transition-colors duration-150 cursor-pointer nav-trigger"
		id="theme-selector-btn"
		aria-label={t('common.nav.theme')}
		title="Theme (Ctrl+K)"
	>
		<Icon name="ph:sun-duotone" class="w-5 h-5 nav-trigger-icon" data-theme-icon="cream" />
		<Icon name="ph:moon-duotone" class="w-5 h-5 nav-trigger-icon hidden" data-theme-icon="cream-dark" />
		<span class="sr-only">Theme</span>
		<span class="nav-label-mobile">Theme</span>
	</button>

	<dialog
		class="fixed inset-0 w-full max-w-xs max-h-[80vh] m-auto p-0 bg-surface text-foreground border-2 border-border rounded-2xl backdrop:backdrop-blur-sm backdrop:bg-black/40"
		data-theme-dialog
	>
		<div class="flex flex-col">
			<div class="flex items-center justify-between p-4 border-b-2 border-border">
				<h2 class="text-base font-semibold text-foreground flex items-center gap-2 m-0">
					<Icon name="ph:palette-duotone" class="w-5 h-5 text-primary" />
					<span>{t('common.nav.theme')}</span>
				</h2>
				<button
					class="p-1 rounded-full text-foreground/70 hover:text-foreground hover:bg-foreground/10 transition-colors duration-150 cursor-pointer"
					data-close-modal
					aria-label="Close"
				>
					<Icon name="ph:x-duotone" class="w-5 h-5" />
				</button>
			</div>

			<div class="flex flex-col gap-2 p-4">
				<button
					class="flex items-center gap-3 p-3 rounded-xl border-2 border-border text-left hover:border-primary transition-colors duration-150 cursor-pointer theme-option"
					data-theme-option="light"
				>
					<Icon name="ph:sun-duotone" class="w-5 h-5 text-primary flex-shrink-0" />
					<span class="text-sm font-medium">{t('common.theme.light')}</span>
					<Icon name="ph:check-circle-duotone" class="w-5 h-5 ml-auto text-primary hidden option-check" />
				</button>
				<button
					class="flex items-center gap-3 p-3 rounded-xl border-2 border-border text-left hover:border-primary transition-colors duration-150 cursor-pointer theme-option"
					data-theme-option="dark"
				>
					<Icon name="ph:moon-duotone" class="w-5 h-5 text-primary flex-shrink-0" />
					<span class="text-sm font-medium">{t('common.theme.dark')}</span>
					<Icon name="ph:check-circle-duotone" class="w-5 h-5 ml-auto text-primary hidden option-check" />
				</button>
				<button
					class="flex items-center gap-3 p-3 rounded-xl border-2 border-border text-left hover:border-primary transition-colors duration-150 cursor-pointer theme-option"
					data-theme-option="system"
				>
					<Icon name="ph:monitor-duotone" class="w-5 h-5 text-primary flex-shrink-0" />
					<span class="text-sm font-medium">{t('common.theme.system')}</span>
					<Icon name="ph:check-circle-duotone" class="w-5 h-5 ml-auto text-primary hidden option-check" />
				</button>

				<label class="flex items-center justify-between gap-3 p-3 mt-1 rounded-xl border-2 border-border cursor-pointer">
					<span class="flex items-center gap-3">
						<Icon name="ph:sparkle-duotone" class="w-5 h-5 text-primary flex-shrink-0" />
						<span class="text-sm font-medium">{t('common.theme.intro')}</span>
					</span>
					<input
						type="checkbox"
						class="sr-only"
						data-intro-toggle
						aria-label={t('common.theme.intro')}
					/>
					<span class="relative w-10 h-5 bg-foreground/20 rounded-full transition-colors duration-150 intro-track flex-shrink-0">
						<span class="intro-indicator absolute top-0.5 left-0.5 w-4 h-4 bg-surface rounded-full transition-transform duration-150"></span>
					</span>
				</label>
			</div>
		</div>
	</dialog>
</div>

<style>
	.theme-option.active {
		border-color: var(--color-primary);
		background-color: color-mix(in srgb, var(--color-primary) 12%, transparent);
	}

	dialog::backdrop {
		animation: theme-dialog-fade 150ms ease-out;
	}

	dialog[open] {
		animation: theme-dialog-pop 200ms cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	@keyframes theme-dialog-fade {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	@keyframes theme-dialog-pop {
		from {
			opacity: 0;
			transform: translateY(12px) scale(0.96);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	/* Fix icon vertical alignment */
	.nav-trigger-icon {
		display: block;
	}

	#theme-selector-btn :global(svg) {
		display: block;
	}
</style>

<script>
	import {
		getCurrentTheme,
		getThemePreference,
		isIntroEnabled,
		onThemeChange,
		resolveThemeForPreference,
		setCurrentTheme,
		setIntroEnabled,
		setThemePreference,
		type ThemePreference,
	} from '../lib/theme-bus';

	(function() {
		const openBtn = document.getElementById('theme-selector-btn') as HTMLButtonElement | null;
		const closeBtn = document.querySelector('[data-close-modal]') as HTMLElement | null;
		const dialog = document.querySelector('[data-theme-dialog]') as HTMLDialogElement | null;
		const optionButtons = document.querySelectorAll<HTMLElement>('[data-theme-option]');
		const introToggle = document.querySelector('[data-intro-toggle]') as HTMLInputElement | null;
		const introTrack = document.querySelector('.intro-track') as HTMLElement | null;
		const introIndicator = document.querySelector('.intro-indicator') as HTMLElement | null;

		function updateTriggerIcon() {
			const current = getCurrentTheme();
			document.querySelectorAll<HTMLElement>('[data-theme-icon]').forEach((icon) => {
				icon.classList.toggle('hidden', icon.dataset.themeIcon !== current);
			});
		}

		function updateActiveOption() {
			const preference = getThemePreference('system');
			optionButtons.forEach((option) => {
				const isActive = option.dataset.themeOption === preference;
				option.classList.toggle('active', isActive);
				option.querySelector('.option-check')?.classList.toggle('hidden', !isActive);
			});
		}

		function updateIntroUI(isEnabled: boolean) {
			introIndicator?.classList.toggle('translate-x-5', isEnabled);
			introTrack?.classList.toggle('bg-primary', isEnabled);
			introTrack?.classList.toggle('bg-foreground/20', !isEnabled);
			introToggle?.setAttribute('aria-pressed', String(isEnabled));
		}

		function openModal() {
			updateActiveOption();
			dialog?.showModal();
		}

		function closeModal() {
			dialog?.close();
		}

		function selectPreference(preference: ThemePreference) {
			setThemePreference(preference);
			setCurrentTheme(resolveThemeForPreference(preference), {
				persist: true,
				source: 'theme-selector',
			});
			updateActiveOption();
		}

		// Event listeners
		openBtn?.addEventListener('click', openModal);
		closeBtn?.addEventListener('click', closeModal);
		dialog?.addEventListener('click', (e) => {
			if (e.target === dialog) closeModal();
		});

		optionButtons.forEach((option) => {
			option.addEventListener('click', () => {
				const preference = option.dataset.themeOption as ThemePreference | undefined;
				if (preference) selectPreference(preference);
			});
		});

		introToggle?.addEventListener('change', (e: Event) => {
			const target = e.target as HTMLInputElement | null;
			if (!target) return;
			setIntroEnabled(target.checked);
			updateIntroUI(target.checked);
		});

		// Keyboard shortcut (Ctrl+K / ⌘+K)
		window.addEventListener('keydown', (e) => {
			if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
				e.preventDefault();
				dialog?.open ? closeModal() : openModal();
			}
		});

		// Keep the trigger icon in sync with external theme changes
		onThemeChange(() => {
			updateTriggerIcon();
			updateActiveOption();
		});

		// Initialize
		if (introToggle) introToggle.checked = isIntroEnabled();
		updateIntroUI(isIntroEnabled());
		updateTriggerIcon();
		updateActiveOption();
	})();
</script>
