---
/**
 * Theme Selector Component
 * 
 * A modal dialog that allows users to select from 60 Shiki themes.
 * Supports keyboard shortcuts (Ctrl+K / ⌘+K) and theme persistence.
 */

import { getThemes, getDarkThemes, getLightThemes } from '../config/themes';

// Load all themes at build time
const allThemes = await getThemes();
const darkThemes = await getDarkThemes();
const lightThemes = await getLightThemes();

// Create a theme map for client-side access
const themeMap = Object.fromEntries(
	allThemes.map(theme => [theme.id, theme.colors])
);
const themeMapJson = JSON.stringify(themeMap);
---

<theme-selector class="inline-flex">
	<!-- Trigger Button -->
	<button
		class="
			flex items-center justify-center
			p-2 rounded-md
			text-foreground/70
			hover:text-primary
			transition-colors duration-150
			cursor-pointer
		"
		data-open-modal
		aria-label="Theme"
		title="Theme (Ctrl+K)"
	>
		<!-- Palette Icon (SVG) -->
		<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
		</svg>
		<span class="sr-only">Theme</span>
	</button>

	<!-- Modal Dialog -->
	<dialog
		class="
			fixed inset-0
			w-full max-w-2xl
			max-h-[80vh]
			m-auto
			p-0
			bg-background
			border border-accent/40
			rounded-lg
			shadow-2xl
			backdrop:backdrop-blur-sm
			backdrop:bg-black/50
		"
		data-theme-dialog
	>
		<div class="flex flex-col h-full">
			<!-- Header -->
			<div class="flex items-center justify-between p-4 border-b border-accent/40">
				<div class="flex items-center gap-4">
					<h2 class="text-lg font-semibold text-foreground">Theme</h2>
					
					<!-- Theme Preference Toggle (All/Dark/Light) -->
					<div class="flex items-center gap-2 text-xs">
						<span class="text-foreground/70">Random:</span>
						<div class="flex bg-foreground/10 rounded-md p-0.5">
							<button
								class="px-2 py-1 rounded transition-colors duration-150"
								data-preference="all"
							>
								All
							</button>
							<button
								class="px-2 py-1 rounded transition-colors duration-150"
								data-preference="dark"
								data-preference-active="true"
							>
								Dark
							</button>
							<button
								class="px-2 py-1 rounded transition-colors duration-150"
								data-preference="light"
							>
								Light
							</button>
						</div>
					</div>
					
					<!-- Lock Toggle -->
					<label class="flex items-center gap-2 cursor-pointer group">
						<input
							type="checkbox"
							class="sr-only"
							data-theme-lock-toggle
							aria-label="Lock theme"
						/>
						<div class="relative w-10 h-5 bg-foreground/20 rounded-full transition-colors duration-150 group-hover:bg-foreground/30">
							<div class="lock-indicator absolute top-0.5 left-0.5 w-4 h-4 bg-foreground rounded-full transition-transform duration-150 flex items-center justify-center">
								<!-- Lock Icon (will be toggled) -->
								<svg class="lock-icon-open w-3 h-3 text-background" fill="currentColor" viewBox="0 0 20 20">
									<path d="M10 2a5 5 0 00-5 5v2a2 2 0 00-2 2v5a2 2 0 002 2h10a2 2 0 002-2v-5a2 2 0 00-2-2H7V7a3 3 0 015.905-.75 1 1 0 001.937-.5A5.002 5.002 0 0010 2z" />
								</svg>
								<svg class="lock-icon-closed w-3 h-3 text-background hidden" fill="currentColor" viewBox="0 0 20 20">
									<path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
								</svg>
							</div>
						</div>
						<span class="text-xs text-foreground/70">Lock</span>
					</label>
				</div>
				<button
					class="
						p-1 rounded-md
						text-foreground/70
						hover:text-foreground
						hover:bg-foreground/10
						transition-colors duration-150
					"
					data-close-modal
					aria-label="Close"
				>
					<!-- X Icon -->
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
					</svg>
				</button>
			</div>

			<!-- Theme Tabs -->
			<div class="flex border-b border-accent/40 px-4">
				<button
					class="
						px-4 py-2 text-sm font-medium
						border-b-2 border-transparent
						text-foreground/70
						hover:text-foreground
						transition-colors duration-150
					"
					data-tab="all"
					data-active="true"
				>
					All ({allThemes.length})
				</button>
				<button
					class="
						px-4 py-2 text-sm font-medium
						border-b-2 border-transparent
						text-foreground/70
						hover:text-foreground
						transition-colors duration-150
					"
					data-tab="dark"
				>
					Dark ({darkThemes.length})
				</button>
				<button
					class="
						px-4 py-2 text-sm font-medium
						border-b-2 border-transparent
						text-foreground/70
						hover:text-foreground
						transition-colors duration-150
					"
					data-tab="light"
				>
					Light ({lightThemes.length})
				</button>
			</div>

			<!-- Theme List -->
			<div class="flex-1 overflow-y-auto p-4">
				<!-- All Themes -->
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-2" data-theme-list="all">
					{allThemes.map((theme) => (
						<button
							class="
								flex flex-col items-start
								p-3 rounded-md
								border border-accent/40
								text-left
								hover:border-primary
								hover:bg-primary/5
								transition-all duration-150
								theme-option
							"
							data-theme-id={theme.id}
							data-theme-type={darkThemes.some(t => t.id === theme.id) ? 'dark' : 'light'}
						>
							<span class="text-sm font-medium text-foreground">
								{theme.name}
							</span>
							<span class="text-xs text-foreground/70 mt-1">
								{theme.description}
							</span>
								<!-- Color Preview -->
								<div class="flex gap-1 mt-2">
									<div
										class="w-4 h-4 rounded-sm border border-accent/40/50"
										style={`background-color: ${theme.colors.background}`}
										title="Background"
									/>
									<div
										class="w-4 h-4 rounded-sm border border-accent/40/50"
										style={`background-color: ${theme.colors.primary}`}
										title="Primary"
									/>
									<div
										class="w-4 h-4 rounded-sm border border-accent/40/50"
										style={`background-color: ${theme.colors.foreground}`}
										title="Foreground"
									/>
							</div>
						</button>
					))}
				</div>

				<!-- Dark Themes -->
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-2 hidden" data-theme-list="dark">
					{darkThemes.map((theme) => (
						<button
							class="
								flex flex-col items-start
								p-3 rounded-md
								border border-accent/40
								text-left
								hover:border-primary
								hover:bg-primary/5
								transition-all duration-150
								theme-option
							"
							data-theme-id={theme.id}
							data-theme-type="dark"
						>
							<span class="text-sm font-medium text-foreground">
								{theme.name}
							</span>
							<span class="text-xs text-foreground/70 mt-1">
								{theme.description}
							</span>
							<div class="flex gap-1 mt-2">
								<div
									class="w-4 h-4 rounded-sm border border-accent/40/50"
									style={`background-color: ${theme.colors.background}`}
								/>
								<div
									class="w-4 h-4 rounded-sm border border-accent/40/50"
									style={`background-color: ${theme.colors.primary}`}
								/>
								<div
									class="w-4 h-4 rounded-sm border border-accent/40/50"
									style={`background-color: ${theme.colors.foreground}`}
								/>
							</div>
						</button>
					))}
				</div>

				<!-- Light Themes -->
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-2 hidden" data-theme-list="light">
					{lightThemes.map((theme) => (
						<button
							class="
								flex flex-col items-start
								p-3 rounded-md
								border border-accent/40
								text-left
								hover:border-primary
								hover:bg-primary/5
								transition-all duration-150
								theme-option
							"
							data-theme-id={theme.id}
							data-theme-type="light"
						>
							<span class="text-sm font-medium text-foreground">
								{theme.name}
							</span>
							<span class="text-xs text-foreground/70 mt-1">
								{theme.description}
							</span>
							<div class="flex gap-1 mt-2">
								<div
									class="w-4 h-4 rounded-sm border border-accent/40/50"
									style={`background-color: ${theme.colors.background}`}
								/>
								<div
									class="w-4 h-4 rounded-sm border border-accent/40/50"
									style={`background-color: ${theme.colors.primary}`}
								/>
								<div
									class="w-4 h-4 rounded-sm border border-accent/40/50"
									style={`background-color: ${theme.colors.foreground}`}
								/>
							</div>
						</button>
					))}
				</div>
			</div>
		</div>
	</dialog>
</theme-selector>

<style>
	/* Active tab styling */
	button[data-tab][data-active="true"] {
		border-color: var(--color-primary);
		color: var(--color-primary);
	}

	/* Current theme highlight */
	.theme-option.current-theme {
		border-color: var(--color-primary);
		background-color: color-mix(in srgb, var(--color-primary) 10%, transparent);
	}

	/* Dialog backdrop animation */
	dialog::backdrop {
		animation: fade-in 150ms ease-out;
	}

	@keyframes fade-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	/* Dialog animation */
	dialog[open] {
		animation: slide-up 150ms ease-out;
	}

	@keyframes slide-up {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>

<script>
	class ThemeSelector extends HTMLElement {
		constructor() {
			super();

			this.openBtn = this.querySelector('[data-open-modal]');
			this.closeBtn = this.querySelector('[data-close-modal]');
			this.dialog = this.querySelector('[data-theme-dialog]');
			this.tabButtons = this.querySelectorAll('[data-tab]');
			this.themeLists = this.querySelectorAll('[data-theme-list]');
			this.themeOptions = this.querySelectorAll('.theme-option');
			this.lockToggle = this.querySelector('[data-theme-lock-toggle]');
			this.controller = new AbortController();

			this.setupEventListeners();
			this.loadLockState();
			this.loadPreferenceState();
			this.setupPreferenceToggle();
		}

		setupEventListeners() {
			// Open modal
			this.openBtn?.addEventListener('click', () => this.openModal());

			// Close modal
			this.closeBtn?.addEventListener('click', () => this.closeModal());
			this.dialog?.addEventListener('click', (e) => {
				if (e.target === this.dialog) {
					this.closeModal();
				}
			});

			// Tab switching
			this.tabButtons.forEach((tab) => {
				tab.addEventListener('click', () => {
					const tabType = tab.dataset.tab;
					if (tabType) {
						this.switchTab(tabType);
					}
				});
			});

			// Theme selection - MultiTerm style: just set data-theme!
			this.themeOptions.forEach((option) => {
				option.addEventListener('click', () => {
					const themeId = option.dataset.themeId;
					if (themeId) {
						this.selectTheme(themeId);
					}
				});
			});

			// Lock toggle
			this.lockToggle?.addEventListener('change', (e) => {
				this.toggleLock(e.target.checked);
			});
		}

		loadLockState() {
			const isLocked = localStorage.getItem('theme-locked') === 'true';
			if (this.lockToggle) {
				this.lockToggle.checked = isLocked;
				this.updateLockUI(isLocked);
			}
		}

		toggleLock(isLocked) {
			localStorage.setItem('theme-locked', isLocked.toString());
			this.updateLockUI(isLocked);
		}

		loadPreferenceState() {
			const preference = localStorage.getItem('theme-preference') || 'dark';
			const buttons = this.querySelectorAll('[data-preference]');
			buttons.forEach(button => {
				const btn = button as HTMLButtonElement;
				const isActive = btn.dataset.preference === preference;
				btn.dataset.preferenceActive = String(isActive);
				if (isActive) {
					btn.style.backgroundColor = 'var(--color-foreground)';
					btn.style.color = 'var(--color-background)';
				} else {
					btn.style.backgroundColor = 'transparent';
					btn.style.color = 'color-mix(in srgb, var(--color-foreground) 70%, transparent)';
				}
			});
		}

		setupPreferenceToggle() {
			const buttons = this.querySelectorAll('[data-preference]');
			buttons.forEach(button => {
				button.addEventListener('click', (e) => {
					const btn = e.target as HTMLButtonElement;
					const preference = btn.dataset.preference;
					if (preference) {
						localStorage.setItem('theme-preference', preference);
						this.loadPreferenceState();
					}
				});
			});
		}

		updateLockUI(isLocked) {
			const indicator = this.querySelector('.lock-indicator');
			const openIcon = this.querySelector('.lock-icon-open');
			const closedIcon = this.querySelector('.lock-icon-closed');
			const toggle = this.querySelector('[data-theme-lock-toggle]');
			
			if (isLocked) {
				indicator?.classList.add('translate-x-5');
				indicator?.parentElement?.classList.add('bg-primary');
				indicator?.parentElement?.classList.remove('bg-foreground/20');
				openIcon?.classList.add('hidden');
				closedIcon?.classList.remove('hidden');
			} else {
				indicator?.classList.remove('translate-x-5');
				indicator?.parentElement?.classList.remove('bg-primary');
				indicator?.parentElement?.classList.add('bg-foreground/20');
				openIcon?.classList.remove('hidden');
				closedIcon?.classList.add('hidden');
			}
		}

		connectedCallback() {
			// Keyboard shortcut (Ctrl+K / ⌘+K)
			window.addEventListener('keydown', (e) => {
				if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
					e.preventDefault();
					if (this.dialog?.open) {
						this.closeModal();
					} else {
						this.openModal();
					}
				}
			}, { signal: this.controller.signal });
		}

		disconnectedCallback() {
			this.controller.abort();
		}

		openModal() {
			this.highlightCurrentTheme();
			this.dialog?.showModal();
			document.body.classList.add('overflow-hidden');
		}

		closeModal() {
			this.dialog?.close();
			document.body.classList.remove('overflow-hidden');
		}

		switchTab(tabType) {
			// Update tab buttons
			this.tabButtons.forEach((tab) => {
				if (tab.dataset.tab === tabType) {
					tab.dataset.active = 'true';
				} else {
					delete tab.dataset.active;
				}
			});

			// Update theme lists
			this.themeLists.forEach((list) => {
				if (list.dataset.themeList === tabType) {
					list.classList.remove('hidden');
				} else {
					list.classList.add('hidden');
				}
			});
		}

		selectTheme(themeId) {
			// MultiTerm style: just set data-theme attribute
			// CSS will automatically match via :root[data-theme="xxx"]
			document.documentElement.setAttribute('data-theme', themeId);
			
			// Save to localStorage
			localStorage.setItem('theme', themeId);
			
			// Save theme preference (dark or light)
			const themeOption = Array.from(this.themeOptions).find(opt => opt.dataset.themeId === themeId);
			if (themeOption) {
				const themeType = themeOption.dataset.themeType;
				if (themeType) {
					localStorage.setItem('theme-preference', themeType);
				}
			}
			
			// Close modal
			this.closeModal();
			
			// Update highlight
			this.highlightCurrentTheme();
		}

		highlightCurrentTheme() {
			const currentTheme = document.documentElement.getAttribute('data-theme') || 'andromeeda';
			
			this.themeOptions.forEach((option) => {
				if (option.dataset.themeId === currentTheme) {
					option.classList.add('current-theme');
				} else {
					option.classList.remove('current-theme');
				}
			});
		}
	}

	customElements.define('theme-selector', ThemeSelector);
</script>
