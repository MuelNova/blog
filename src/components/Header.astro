---
import { SITE_TITLE } from '../consts';
import ThemeSelector from './ThemeSelector.astro';
import { Icon } from 'astro-icon/components';

const path = Astro.url.pathname;
---

<nav>
	<a class="site-title" href="/">{SITE_TITLE}</a>
	<ul id="primary-nav">
		<li>
			<a href="/" class:list={{ active: path === '/' }}>Home</a>
		</li>
		<li class="nav-separator">/</li>
		<li>
			<a href="/blog" class:list={{ active: path.startsWith('/blog') }}>Blog</a>
		</li>
		<li class="nav-separator">/</li>
		<li>
			<a href="/about" class:list={{ active: path.startsWith('/about') }}>About</a>
		</li>
		<li class="nav-separator theme-separator">/</li>
		<li class="theme-nav-item">
			<ThemeSelector />
		</li>
	</ul>
	<button
		class="mobile-nav-toggle"
		aria-label="Mobile menu"
		aria-expanded="false"
		aria-controls="primary-nav"
	>
		<Icon name="ph:list-duotone" class="menu-closed w-6 h-6" />
		<Icon name="ph:x-duotone" class="menu-open w-6 h-6" />
	</button>
</nav>

<script is:inline>
	const navToggle = document.querySelector('.mobile-nav-toggle');
	const nav = document.querySelector('nav');

	navToggle?.addEventListener('click', () => {
		navToggle.classList.toggle('active');
		nav?.classList.toggle('active');
		const expanded = navToggle.classList.contains('active');
		navToggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
	});
</script>

<style>
	nav {
		width: 100%;
		max-width: 1280px;
		margin: 0 auto;
		padding: 2rem 1rem 0;
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-family: 'Geist Mono', 'Courier New', Courier, monospace;
		z-index: 50;
	}

	.site-title {
		font-weight: 800;
		text-decoration: none;
		font-size: 1.25rem;
		z-index: 2;
		color: var(--color-foreground);
	}

	nav ul {
		display: flex;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style-type: none;
		align-items: center;
	}

	nav ul li {
		position: relative;
	}

	nav a {
		color: var(--color-foreground);
		text-decoration: none;
		padding: 0.25rem 0.5rem;
		transition: all 150ms ease;
	}

	nav a:hover,
	nav a:focus-visible {
		color: var(--color-accent);
		background-color: color-mix(in srgb, var(--color-accent) 10%, transparent);
		outline: none;
	}

	nav a.active {
		color: var(--color-background);
		background-color: var(--color-accent);
		outline: none;
	}

	.nav-separator {
		color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
		user-select: none;
	}

	.mobile-nav-toggle {
		display: none;
		width: 40px;
		height: 40px;
		background-color: var(--color-background);
		border: 2px solid color-mix(in srgb, var(--color-accent) 20%, transparent);
		align-items: center;
		justify-content: center;
		cursor: pointer;
		z-index: 2;
		color: var(--color-accent);
		transition: all 150ms ease;
	}

	.mobile-nav-toggle:hover {
		background-color: color-mix(in srgb, var(--color-accent) 10%, transparent);
	}

	.menu-open {
		display: none;
	}

	.mobile-nav-toggle.active .menu-open {
		display: flex;
	}

	.mobile-nav-toggle.active .menu-closed {
		display: none;
	}

	@media screen and (max-width: 640px) {
		nav {
			padding-top: 1rem;
			transition: all 0.25s ease;
		}

		.mobile-nav-toggle {
			display: flex;
		}

		:global(.nav-separator),
		nav :global(.theme-separator) {
			display: none;
		}

		nav ul {
			flex-direction: column;
			gap: 0;
			position: absolute;
			width: 100%;
			top: calc(1rem + 40px);
			left: 0;
			padding: 1rem;
			z-index: 1;
			opacity: 0;
			pointer-events: none;
			transition: all 0.25s ease;
			user-select: none;
			height: calc(100vh - 1rem - 40px);
			align-items: start;
		}

		nav.active {
			background-color: var(--color-background);
		}

		nav.active ul {
			opacity: 1;
			pointer-events: all;
			background-color: var(--color-background);
		}

		nav ul li {
			position: relative;
			transition: all 0.25s ease-out;
			top: -1.5rem;
			border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 20%, transparent);
			width: 100%;
			max-width: none;
			padding: 0;
			font-size: 1.125rem;
		}

		nav ul li:last-child {
			border-bottom: none;
		}

		nav ul li a {
			display: block;
			padding: 0.75rem 0;
			width: 100%;
			padding-left: 1rem;
		}

		nav ul li:first-child {
			border-top: 1px solid color-mix(in srgb, var(--color-accent) 20%, transparent);
		}

		nav.active ul li {
			top: 0;
		}
	}
</style>
