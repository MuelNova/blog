---
import ThemeSelector from './ThemeSelector.astro';
import { Icon } from 'astro-icon/components';
import { SITE_TITLE } from '../consts';

const path = Astro.url.pathname;
---

<nav
	class="header-nav relative z-[50] w-full max-w-[1280px] mx-auto px-4 pt-8 flex items-center justify-between"
	data-open="false"
>
	<a class="font-extrabold text-xl no-underline z-[2]" href="/">{SITE_TITLE}</a>

	<ul
		id="primary-nav"
		class="nav-list hidden flex-col absolute left-0 right-0 top-[calc(2rem+2.5rem)] z-[40] p-4 gap-0 bg-[color:var(--color-background)] shadow-xl opacity-0 pointer-events-none transition-all duration-200 ease-out sm:static sm:flex sm:flex-row sm:items-center sm:gap-4 sm:p-0 sm:opacity-100 sm:pointer-events-auto sm:shadow-none"
	>
		<li class="w-full sm:w-auto">
			<a href="/" class="nav-link">
				Home
			</a>
		</li>
		<li class="nav-separator hidden sm:inline text-[color-mix(in_srgb,var(--color-foreground)_70%,transparent)] select-none">/</li>
		<li class="w-full sm:w-auto">
			<a href="/blog" class="nav-link">
				Blog
			</a>
		</li>
		<li class="nav-separator hidden sm:inline text-[color-mix(in_srgb,var(--color-foreground)_70%,transparent)] select-none">/</li>
		<li class="w-full sm:w-auto">
			<a href="/about" class="nav-link">
				About
			</a>
		</li>
		<li class="nav-separator hidden sm:inline text-[color-mix(in_srgb,var(--color-foreground)_70%,transparent)] select-none">/</li>
		<li class="w-full sm:w-auto sm:pl-1">
			<ThemeSelector />
		</li>
	</ul>

	<button
		class="inline-flex h-10 w-10 items-center justify-center border-2 border-[color-mix(in_srgb,var(--color-accent)_20%,transparent)] bg-[color:var(--color-background)] text-[color:var(--color-accent)] transition-colors duration-150 sm:hidden z-[50]"
		data-nav-toggle
		aria-label="Mobile menu"
		aria-expanded="false"
		aria-controls="primary-nav"
	>
		<Icon name="ph:list-duotone" class="menu-closed w-6 h-6" />
		<Icon name="ph:x-duotone" class="menu-open w-6 h-6 hidden" />
	</button>
</nav>

<style>
	.header-nav a {
		color: var(--color-foreground);
		text-decoration: none;
	}

	.header-nav li:hover > a,
	.header-nav li:focus-within > a {
		color: var(--color-foreground);
		background-color: var(--color-accent)
	}

	.nav-link {
		display: block;
		padding: 0.25rem 0.5rem;
		font-size: 1.125rem;
		line-height: 1.5;
		color: var(--color-foreground);
		transition: color 150ms ease, background-color 150ms ease;
	}

	@media (min-width: 640px) {
		.nav-link {
			padding: 0.25rem 0.5rem;
			font-size: 1rem;
		}
	}

	@media (min-width: 640px) {
		.nav-list {
			display: flex !important;
		}
	}

	[data-open='true'] .nav-list {
		display: flex;
		opacity: 1;
		pointer-events: auto;
	}

	[data-open='true'] .menu-closed {
		display: none;
	}

	[data-open='true'] .menu-open {
		display: block;
	}

	@media (max-width: 639px) {
		.nav-list {
			height: calc(100vh - 2rem - 2.5rem);
			overflow: auto;
		}

		.nav-list li {
			width: 100%;
			border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 20%, transparent);
		}

		.nav-list li:last-child {
			border-bottom: none;
		}
	}
</style>

<script is:inline>
	const nav = document.querySelector('nav[data-open]');
	const toggle = document.querySelector('[data-nav-toggle]');

	if (nav && toggle) {
		toggle.addEventListener('click', () => {
			const isOpen = nav.getAttribute('data-open') === 'true';
			nav.setAttribute('data-open', isOpen ? 'false' : 'true');
			toggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
		});
	}
</script>
