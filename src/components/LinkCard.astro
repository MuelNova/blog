---
import type { LinkCardProps } from '../config/links';

interface Props extends LinkCardProps {}

const { link, linkText, description, icon } = Astro.props;

// Fallback icon
const fallbackIcon = '/favicon.png';
---

<a
	href={link}
	class="link-card"
	target="_blank"
	rel="noopener noreferrer"
>
	<span class="link-icon">
		<img
			src={icon || fallbackIcon}
			alt={linkText}
			loading="lazy"
			onerror={`this.onerror=null; this.src='${fallbackIcon}'`}
		/>
	</span>
	<span class="link-content">
		<span class="link-title">{linkText}</span>
		<span class="link-description">{description}</span>
	</span>
</a>

<style>
	/* Horizontal capsule card — sticker style, lavender hover */
	.link-card {
		/* lavender = pink accent × misty blue accent-2 */
		--link-lavender: color-mix(in srgb, var(--color-accent) 50%, var(--color-accent-2) 50%);
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.75rem 1.25rem 0.75rem 0.75rem;
		border: 2px solid var(--color-border);
		border-radius: 100px;
		background: var(--color-surface);
		text-decoration: none;
		transition: border-color 200ms ease, transform 400ms var(--ease-pop), background-color 200ms ease;
	}

	@media (hover: hover) {
		.link-card:hover,
		.link-card:focus-visible {
			border-color: var(--link-lavender);
			background: color-mix(in srgb, var(--link-lavender) 12%, var(--color-surface));
			transform: rotate(1.5deg) scale(1.02);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.link-card {
			transition: border-color 200ms ease, background-color 200ms ease;
		}

		.link-card:hover,
		.link-card:focus-visible {
			transform: none;
		}
	}

	.link-icon {
		flex-shrink: 0;
		width: 3rem;
		height: 3rem;
		border: 2px solid var(--color-border);
		border-radius: 9999px;
		overflow: hidden;
		background: var(--color-background);
		transition: border-color 200ms ease;
	}

	.link-card:hover .link-icon,
	.link-card:focus-visible .link-icon {
		border-color: var(--link-lavender);
	}

	.link-icon img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.link-content {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
	}

	.link-title {
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--color-foreground);
		line-height: 1.4;
		transition: color 200ms ease;
	}

	.link-card:hover .link-title,
	.link-card:focus-visible .link-title {
		color: color-mix(in srgb, var(--color-accent) 55%, var(--color-foreground));
	}

	.link-description {
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--color-foreground-secondary);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
</style>
